{
  "hooks": {
    "SubagentStop": [
      {
        "matcher": "critic$",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.last_assistant_message // empty' | \"$CLAUDE_PROJECT_DIR\"/.agent/scripts/verdict || exit 2"
          }
        ]
      }
    ]
  }
}
