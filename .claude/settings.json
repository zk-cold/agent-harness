{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "m=$(jq -er 'select(.agent_type // \"\" | endswith(\"critic\")) | .tool_input.message // \"\"') || exit 0; printf %s \"$m\" | \"$CLAUDE_PROJECT_DIR\"/.agent/scripts/verdict || exit 2"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "critic$",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.last_assistant_message // empty' | \"$CLAUDE_PROJECT_DIR\"/.agent/scripts/verdict || exit 2"
          }
        ]
      }
    ]
  }
}
