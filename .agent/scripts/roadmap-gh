#!/usr/bin/env bash
set -euo pipefail
r='repos/{owner}/{repo}'
trusted='select(.author_association | IN("OWNER", "MEMBER", "COLLABORATOR"))'

open_subs() {
  gh api --paginate "$r/issues/$1/sub_issues?per_page=100" --jq '.[] | select(.state == "open") | .number'
}

items() {
  gh api --paginate "$r/issues?state=open&per_page=100" \
    --jq ".[] | select(.pull_request == null) | $trusted | [.number, (.sub_issues_summary.total // 0), .title] | @tsv"
}

list() {
  items | cut -f 1,3
}

candidates() {
  local subs
  items | while IFS=$'\t' read -r n total title; do
    subs=
    [ "$total" = 0 ] || subs=$(open_subs "$n")
    [ -n "$subs" ] || printf '%s\t%s\n' "$n" "$title"
  done
}

show() {
  gh api "$r/issues/$1" --jq "$trusted"' | .title + "\n\n" + (.body // "") + "\n"'
  gh api --paginate "$r/issues/$1/comments?per_page=100" --jq ".[] | $trusted"' | .body + "\n"'
}

add() {
  local new
  new=$(gh api "$r/issues" -f title="$1" -f body="$2" --jq '"\(.number) \(.id)"')
  [ -z "${3-}" ] || gh api "$r/issues/$3/sub_issues" -F sub_issue_id="${new#* }" >/dev/null
  echo "${new% *}"
}

shut() {
  local state subs s
  state=$(gh api "$r/issues/$1" --jq .state)
  [ "$state" = open ] || return 0
  subs=$(open_subs "$1")
  for s in $subs; do shut "$s" not_planned; done
  gh api -X PATCH "$r/issues/$1" -f state=closed -f state_reason="$2" >/dev/null
}

edit() {
  gh api -X PATCH "$r/issues/$1" -f title="$2" ${3+-f body="$3"} >/dev/null
}

close() {
  shut "$1" not_planned
}

complete() {
  local parent subs
  shut "$1" completed
  parent=$(gh api "$r/issues/$1" --jq '(.parent_issue_url // "" | split("/") | last) // ""')
  [ -n "$parent" ] || return 0
  subs=$(open_subs "$parent")
  [ -n "$subs" ] || complete "$parent"
}

case $1 in
  candidates | list | show | add | edit | close | complete) "$@" ;;
  *) exit 2 ;;
esac
