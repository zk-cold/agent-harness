schema=$(dirname "${BASH_SOURCE[0]}")/../schemas/governance-schema.md
section() { awk -v s="## $1" '/^## /{on = $0 == s} on' "${2:-$schema}"; }
listed() { section "$@" | awk 'sub(/^- `?/, "") {sub(/[`: ].*/, ""); print}'; }
governed() { section 'Governed Documents' | grep -o '`[^`]*`' | tr -d '`'; }
