#!/usr/bin/env bash
set -euo pipefail
[ $# -ge 6 ] || { echo "usage: $0 <backend> <target repo path> <item> <worktree> <root branch> <review ID>..." >&2; exit 2; }
[ -z "${AGENT_HARNESS_IMPL-}" ] || { echo 'Label or close no roadmap items.' >&2; exit 2; }
s=$(cd "$(dirname "$0")" && pwd)
road=("$s/roadmap" "$1" "$2")
m=$(git -C "$2" rev-parse --path-format=absolute --git-common-dir)/land-$3
k=$(cat "$m" 2>/dev/null) || true
c=$(git -C "$4" rev-parse HEAD 2>/dev/null) || c=${k%% *}
if [ "$k" != "$c $4" ]; then
  b=$(git -C "$4" symbolic-ref --short HEAD)
  for r in "$4" "$2"; do [ -z "$(git -C "$r" status --porcelain)" ] || { echo "$r: not clean" >&2; exit 1; }; done
  [ "$(git -C "$2" symbolic-ref --short HEAD)" = "$5" ] || { echo "$2: not on $5" >&2; exit 1; }
  "$s/review" approved "${@:4}"
  "$s/check" "$4"
  [ ! -e "$2/.agent/schemas/harness-home.md" ] || (cd "$4" && "$2/.agent/scripts/governance-growth" "$b" "$3")
  h=$(git -C "$2" rev-parse HEAD)
  if [ -n "${LAND_MERGE-}" ]; then (cd "$2" && sh -c "$LAND_MERGE" land "$b" "$3"); else git -C "$2" merge -q --no-ff -m "Merge $b (#$3)" "$b"; fi ||
    { git -C "$2" reset -q --merge "$h"; exit 1; }
  echo "$c $4" >"$m"
fi
trap '[ $? = 0 ] || echo "$4: merged into $5; rerun land to complete $3" >&2' EXIT
subs=$("${road[@]}" descendants "$3" | cut -f 1 | tac)
for i in $subs; do "${road[@]}" complete "$i"; done
"${road[@]}" complete "$3"
rm "$m"
