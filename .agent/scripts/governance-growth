#!/usr/bin/env bash
set -euo pipefail
. "$(dirname "$0")/schema"
mapfile -t docs < <(governed)
[ ${#docs[@]} -gt 0 ] || { echo "$schema: no docs" >&2; exit 1; }
docs=("${docs[@]/#/:(top,glob)}")
words() { { git grep -hoE -e '[^[:space:]]+' "$1" -- "${docs[@]}" || [ $? = 1 ]; } | wc -l; }
root=$(git --git-dir="$(git rev-parse --git-common-dir)" rev-parse HEAD)
old=$(words "$(git merge-base "$root" "$1")")
new=$(words "$1")
echo $((new - old))
[ "$new" -le "$old" ] || "$(dirname "$0")/roadmap" gh . approved "$2"
