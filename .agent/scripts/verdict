#!/usr/bin/env bash
n=0 verdict= part=0 filled=1 grounds=0
fail() { echo "line $n" >&2; exit 1; }
while IFS= read -r line || [ -n "$line" ]; do
  n=$((n + 1))
  [[ $line =~ [^[:space:]] ]] || continue
  if [ -z "$verdict" ]; then
    [[ $line =~ ^Verdict:\ (APPROVE|REJECT)[[:space:]]*$ ]] || fail
    verdict=${BASH_REMATCH[1]}
  elif [[ $line =~ ^(Rejection\ Grounds|Findings):(.*) ]]; then
    case ${BASH_REMATCH[1]} in
      Findings) next=2 ;;
      *) next=1 grounds=1 ;;
    esac
    [ "$filled" = 1 ] && [ "$next" -gt "$part" ] || fail
    part=$next filled=0
    [[ ! ${BASH_REMATCH[2]} =~ [^[:space:]] ]] || filled=1
  else
    [ "$part" -gt 0 ] || fail
    filled=1
  fi
done
[ "$filled" = 1 ] || fail
[ "$verdict:$grounds" = APPROVE:0 ] || [ "$verdict:$grounds" = REJECT:1 ] || fail
echo "$verdict"
