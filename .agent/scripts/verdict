#!/usr/bin/env bash
n=0 verdict= part=0 filled=1 grounds=0
want='first line must be Verdict: APPROVE or Verdict: REJECT'
fail() { echo "line $1: $2" >&2; exit 1; }
while IFS= read -r line || [ -n "$line" ]; do
  n=$((n + 1))
  [[ $line =~ [^[:space:]] ]] || continue
  if [ -z "$verdict" ]; then
    [[ $line =~ ^Verdict:\ (APPROVE|REJECT)[[:space:]]*$ ]] || fail "$n" "$want"
    verdict=${BASH_REMATCH[1]} v=$n
  elif [[ $line =~ ^(Rejection\ Grounds|Findings):(.*) ]]; then
    [ "$filled" = 1 ] || fail "$at" "$name is empty"
    name=${BASH_REMATCH[1]} rest=${BASH_REMATCH[2]} at=$n
    case $name in
      Findings) next=2 ;;
      *) next=1 grounds=1
        [ "$verdict" = REJECT ] || fail "$n" 'APPROVE must omit Rejection Grounds' ;;
    esac
    [ "$next" -gt "$part" ] || fail "$n" 'Rejection Grounds and Findings each appear at most once, in that order'
    part=$next filled=0
    [[ ! $rest =~ [^[:space:]] ]] || filled=1
  else
    [ "$part" -gt 0 ] || fail "$n" 'text must be under Rejection Grounds or Findings'
    filled=1
  fi
done
[ -n "$verdict" ] || fail $((n + 1)) "$want"
[ "$filled" = 1 ] || fail "$at" "$name is empty"
[ "$verdict" = APPROVE ] || [ "$grounds" = 1 ] || fail "$v" 'REJECT needs Rejection Grounds'
echo "$verdict"
