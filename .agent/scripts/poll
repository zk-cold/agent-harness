#!/usr/bin/env bash
set -euo pipefail
state=$(git -C "$2" rev-parse --absolute-git-dir)/roadmap-poll
backend=$1 repo=$2
road() { "$(dirname "$0")/roadmap" "$backend" "$repo" "$@"; }
seen=$(cat "$state" 2>/dev/null) || seen=
fingerprint() {
  local n
  printf '%s\n' "$out"
  for n in $(cut -f 1 <<<"$out"); do
    road show "$n" || return
    if road approved "$n"; then echo approved; else [ $? = 1 ] || return; echo -; fi
  done
}
fails=0
while sleep 30; do
  out=$(road candidates) && now=$(fingerprint) || { ((++fails < 5)) || exit; continue; }
  fails=0
  [ "$now" != "$seen" ] || continue
  seen=$now
  printf '%s\n' "$now" >"$state" || :
  [ -z "$out" ] || { printf '%s\n' "$out"; exit; }
done
