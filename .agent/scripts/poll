#!/usr/bin/env bash
set -euo pipefail
state=$(git -C "$2" rev-parse --absolute-git-dir)/roadmap-poll
seen=$(cat "$state" 2>/dev/null) || seen=
while sleep 30; do
  out=$("$(dirname "$0")/roadmap" "$1" "$2" candidates) && [ "$out" != "$seen" ] || continue
  printf '%s\n' "$out" >"$state" || :
  [ -z "$out" ] || { printf '%s\n' "$out"; exit; }
done
