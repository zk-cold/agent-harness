#!/usr/bin/env bash
set -euo pipefail
[[ $# -ge 4 && $1 = approved || $# = 3 && $1 = wait || $# = 1 && $1 =~ ^(spawn|handback|record|guard)$ ]] ||
  { echo "usage: $0 approved <worktree> <root branch> <review ID>... | wait <worktree> <review ID> | spawn | handback | record | guard" >&2; exit 2; }
s=$(cd "$(dirname "$0")" && pwd)
h=${s%/.agent/scripts}
x=$(mktemp -d)
trap 'rm -rf "$x"' EXIT
mkdir "$x/objects"
fingerprint() {
  w=$(cd "$1" && pwd) && b=$2 && d=$(git -C "$w" rev-parse --path-format=absolute --git-common-dir)/critic-reviews &&
    change=$(cd "$w" && export GIT_INDEX_FILE=$x/index && git read-tree HEAD && GIT_OBJECT_DIRECTORY=$x/objects git add -A -N &&
      git diff --full-index --no-renames --no-ext-diff --no-textconv --no-color "$(git merge-base HEAD "$b")" |
      awk '/^index /{i = $0; next} /^Binary files /{print i} !/^@@/' | git hash-object --stdin)
}
ours() {
  [[ $1 =~ ^($(jq -r .name "$h/.claude-plugin/plugin.json"):)?$2$ ]]
}
critic() {
  local c=${1##*:}
  [[ $c =~ ^[a-z-]+-critic$ && -f $h/.claude/agents/$c.md ]] && ours "$1" "$c"
}
prompt() {
  jq -rs 'map(select(.type == "user"))[0].message.content | strings' "$1"
}
re=$'^\\$\\{CLAUDE_PLUGIN_ROOT\\}: [^\n]+\nWorktree: ([^\n ]+)\nRoot Branch: ([^\n ]+)\nFingerprint: ([0-9a-f]+)$'
transcribed() {
  local t m a q p
  for t in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/*/subagents/agent-"$2".jsonl; do
    m=${t%.jsonl}.meta.json
    a=$(jq -r .agentType "$m") && critic "$a" && [ "${a##*:}" = "$1" ] &&
      [[ $(prompt "$t") = *$'\nFingerprint: '"$change" ]] &&
      q=$(jq -r .parentAgentId "$m") && [[ $q =~ ^[^/]+$ ]] && p=${t%/*}/agent-$q &&
      ours "$(jq -r .agentType "$p.meta.json")" impl &&
      jq -se --slurpfile m "$m" --slurpfile p "$p.meta.json" --arg c "$1" '$m[0].spawnDepth == $p[0].spawnDepth + 1 and
        any(.[] | select(.type == "assistant") | .message.content[]?; .type == "tool_use" and .id == $m[0].toolUseId and
          (.input.subagent_type | split(":")[-1]) == $c)' "$p.jsonl" >/dev/null &&
      [ "$(jq -rs '[.[] | select(.type == "assistant") | .message.content[]?] |
        (map(select(.name == "SubagentHandback"))[-1].input.message // map(select(.type == "text"))[-1].text // "")' "$t" |
        "$s/verdict")" = APPROVE ] && return
  done 2>/dev/null
  return 1
}
approves() {
  local rc rf
  [[ $2 =~ ^[^/]+$ ]] && { read -r rc && read -r rf && [ "$rc $rf" = "$1 $change" ] &&
    [ "$("$s/verdict")" = APPROVE ]; } 2>/dev/null <"$d/$2" && transcribed "$1" "$2"
}
words() {
  tr ',` \t' '\n\n\n\n' <<<"$1" | grep -vx -- '-*'
}
fail() {
  echo "$1" >&2
  exit 1
}
report() (
  declare -A part
  l= last=-1 labels='Verdict|Approvals|Escalation|Unhandled Findings|Worktree'
  while IFS= read -r line || [ -n "$line" ]; do
    if [[ $line =~ ^($labels):(.*) ]]; then
      l=${BASH_REMATCH[1]} line=${BASH_REMATCH[2]} k=${labels%%"$l"*}
      [ "${#k}" -gt "$last" ] || fail "$l: repeated or out of order"
      last=${#k} part[$l]=
    elif [ -z "$l" ] && [[ $line =~ [^[:space:]] ]]; then
      fail 'a report must start with Verdict:'
    fi
    [ -z "$l" ] || part[$l]+=$line$'\n'
  done <<<"$1"
  for l in "${!part[@]}"; do [[ ${part[$l]} =~ [^[:space:]] ]] || fail "$l: empty"; done
  [[ ${part[Verdict]-} =~ ^[[:space:]]*(READY|NOT READY)[[:space:]]*$ ]] || fail 'Verdict: must be READY or NOT READY'
  v=${BASH_REMATCH[1]}
  for l in Approvals Escalation 'Unhandled Findings' Worktree; do
    case "$v $l" in
      'READY Escalation' | 'NOT READY Approvals' | 'NOT READY Unhandled Findings') [ -z "${part[$l]+1}" ] || fail "$l: not allowed when $v" ;;
      'READY Approvals' | *' Worktree') [ -n "${part[$l]+1}" ] || fail "$l: missing" ;;
    esac
  done
  [ "$v" = READY ] || exit 0
  w=$(words "${part[Worktree]}" | head -n 1)
  [ -z "$(git -C "$w" status --porcelain)" ] || fail "$w: not clean"
  mapfile -t ids < <(words "${part[Approvals]}")
  for id in "${ids[@]}"; do
    for t in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/*/subagents/agent-"$id".jsonl; do
      [[ $(prompt "$t" 2>/dev/null) =~ $re ]] && exec "$s/review" approved "$w" "${BASH_REMATCH[2]}" "${ids[@]}"
    done
  done
  fail 'Approvals: no review found'
)
transcript() {
  jq -r '.agent_transcript_path // ((.transcript_path | rtrimstr(".jsonl")) + "/subagents/agent-\(.agent_id).jsonl")' <<<"$i"
}
case $1 in
  spawn)
    i=$(cat)
    a=$(jq -r '.tool_input.subagent_type // ""' <<<"$i")
    r='${CLAUDE_PLUGIN_ROOT}: '$h
    if critic "$a"; then
      read -r w b _ <<<"$(jq -r '.tool_input.prompt // ""' <<<"$i")"
      [ -n "$b" ] && fingerprint "$w" "$b" || { echo "A critic's prompt must hold only your worktree's path and the root branch." >&2; exit 2; }
      . "$s/schema"
      c=${a##*:}
      named() { section "$1" "$h/.claude/agents/impl.md" | grep -o '`[a-z-]*-critic`' | tr -d '`'; }
      [ "$(named 'Syncing Before Review')" != "$c" ] || git -C "$w" merge-base --is-ancestor "$b" HEAD ||
        { echo "$w: $b is not merged" >&2; exit 2; }
      q=$(named 'Review Loop' | awk -v c="$c" '$0 == c {print p; exit} {p = $0}')
      if [ -n "$q" ]; then
        ok=
        for id in $(ls -t "$d" 2>/dev/null); do
          { read -r _ && read -r f; } <"$d/$id" 2>/dev/null && [ "$f" = "$change" ] || continue
          approves "$q" "$id" && ok=1
          break
        done
        [ -n "$ok" ] || { echo "$c: the latest review of the change as it stands is not an approval by $q" >&2; exit 2; }
      fi
      p=$r$'\nWorktree: '"$w"$'\nRoot Branch: '"$b"$'\nFingerprint: '"$change"
    else
      ours "$a" impl || exit 0
      p=$(jq -r '.tool_input.prompt // ""' <<<"$i")
      t=${p%%$'\n'*}
      [[ $t = /* ]] && git -C "$t" rev-parse 2>/dev/null || { echo "An impl's prompt must start with the target repo's path on its own line." >&2; exit 2; }
      p=$r$'\n'$p
    fi
    jq -c --arg p "$p" '{hookSpecificOutput: {hookEventName: "PreToolUse", updatedInput: (.tool_input | .prompt = $p)}}' <<<"$i"
    exit ;;
  handback | record)
    i=$(cat)
    a=$(jq -r '.agent_type // ""' <<<"$i")
    k=.last_assistant_message
    [ "$1" = record ] || k=.tool_input.message
    m=$(jq -r "$k // \"\"" <<<"$i")
    t=$(transcript)
    final() { [ "$1" = record ] && jq -e .stop_hook_active <<<"$i" >/dev/null; }
    if ours "$a" impl; then
      n=
      [ "$1" = handback ] || n=$(jq -rs '[.[] | select(.type == "assistant") | .message.content[]? | select(.name? == "SubagentHandback")][-1].input.message // empty' "$t" 2>/dev/null) || :
      [ -z "$n" ] || ! report "$n" 2>/dev/null || exit 0
      report "$m" || { final "$1" && exit 1; exit 2; }
      exit
    fi
    critic "$a" || exit 0
    id=$(jq -r .agent_id <<<"$i")
    [[ $id =~ ^[^/]+$ ]] || { echo "$id: invalid agent ID" >&2; exit 1; }
    p=$(prompt "$t") || exit 1
    [[ $p =~ $re ]] || { echo "$id: prompt not set by $0 spawn" >&2; exit 1; }
    f=${BASH_REMATCH[3]}
    fingerprint "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    [ ! -e "$d/$id" ] || exit 0
    rc=0
    printf %s "$m" | "$s/verdict" >/dev/null || { final "$1" || exit 2; rc=1; }
    [ "$change" = "$f" ] || { echo "$w: changed during the review" >&2; rc=1; }
    [ "$rc" = 0 ] || change=-
    mkdir -p "$d"
    printf '%s\n%s\n%s\n' "${a##*:}" "$change" "$m" >"$d/.$id" && mv "$d/.$id" "$d/$id"
    ls -t "$d" | tail -n +101 | (cd "$d" && xargs -rd '\n' rm -f --)
    exit "$rc" ;;
  wait)
    [[ $3 =~ ^[^/.][^/]*$ ]] || fail "$3: invalid review ID"
    d=$(git -C "$2" rev-parse --path-format=absolute --git-common-dir)/critic-reviews
    active() {
      local c
      stat -c %Y "$1.jsonl" "$1.meta.json" 2>/dev/null
      for c in "${1%/*}"/agent-*.meta.json; do
        [ "$(jq -r .parentAgentId "$c" 2>/dev/null)" != "${1##*/agent-}" ] || active "${c%.meta.json}"
      done
    }
    until [ -e "$d/$3" ]; do
      m=
      for t in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/*/subagents/agent-"$3".meta.json; do
        critic "$(jq -r .agentType "$t" 2>/dev/null)" && m=$t
      done
      [ -n "$m" ] || fail "$3: no critic of ours has this ID"
      l=1800
      ! jq -e .finished "$m" >/dev/null || l=60
      [ $(($(date +%s) - $(active "${m%.meta.json}" | sort -n | tail -n 1))) -lt "$l" ] ||
        fail "$3: the critic stopped without its review being recorded"
      sleep 5
    done
    tail -n +3 "$d/$3"
    exit ;;
  guard)
    i=$(cat)
    ours "$(jq -r '.agent_type // ""' <<<"$i")" impl || exit 0
    api='api\.github\.com' write='(-X|--request|method)\W{0,3}(post|patch|put|delete)|--data|-d\b|--json|\.(post|patch|put|delete)\(|mutation'
    closing='(close|delete)issue|labels?(ids|tolabelable|fromlabelable)|state\W{0,4}closed|/labels|"labels?"\s*:|labels='
    ! jq -e --arg a "$api" --arg w "$write" --arg c "$closing" '.tool_input | .state == "closed" or .labels != null or
      (.command // "" | test($a) and test($w; "i") and test($c; "i"))' <<<"$i" >/dev/null ||
      { echo 'Label or close no roadmap items.' >&2; exit 2; }
    jq -e '.tool_input.command // "" | test("\\b(gh|roadmap|land)\\b")' <<<"$i" >/dev/null || exit 0
    t=$(prompt "$(transcript)" 2>/dev/null | sed -n 2p) || :
    p=$(printf 'export PATH=%q:"$PATH" AGENT_HARNESS_IMPL=%q' "$s/impl-bin" "$t")
    jq -c --arg p "$p" '{hookSpecificOutput: {hookEventName: "PreToolUse",
      updatedInput: (.tool_input | .command = $p + "\n" + .command)}}' <<<"$i"
    exit ;;
esac
fingerprint "$2" "$3"
fail=0
for f in "$h"/.claude/agents/*-critic.md; do
  c=$(basename "$f" .md) ok=
  for id in "${@:4}"; do
    approves "$c" "$id" && ok=1
  done
  [ -n "$ok" ] || { echo "$c: no approval of the change as it stands" >&2; fail=1; }
done
exit "$fail"
