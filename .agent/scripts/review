#!/usr/bin/env bash
set -euo pipefail
[[ $# -ge 4 && $1 = approved || $# = 1 && $1 =~ ^(spawn|handback|record)$ ]] ||
  { echo "usage: $0 approved <worktree> <root branch> <review ID>... | spawn | handback | record" >&2; exit 2; }
s=$(cd "$(dirname "$0")" && pwd)
h=${s%/.agent/scripts}
x=$(mktemp -d)
trap 'rm -rf "$x"' EXIT
mkdir "$x/objects"
fingerprint() {
  w=$(cd "$1" && pwd) && b=$2 && d=$(git -C "$w" rev-parse --path-format=absolute --git-common-dir)/critic-reviews &&
    change=$(cd "$w" && export GIT_INDEX_FILE=$x/index && git read-tree HEAD && GIT_OBJECT_DIRECTORY=$x/objects git add -A -N &&
      git diff --full-index --no-renames --no-ext-diff --no-textconv --no-color "$(git merge-base HEAD "$b")" |
      awk '/^index /{i = $0; next} /^Binary files /{print i} !/^@@/' | git hash-object --stdin)
}
ours() {
  [[ $1 =~ ^($(jq -r .name "$h/.claude-plugin/plugin.json"):)?$2$ ]]
}
critic() {
  local c=${1##*:}
  [[ $c =~ ^[a-z-]+-critic$ && -f $h/.claude/agents/$c.md ]] && ours "$1" "$c"
}
prompt() {
  jq -rs 'map(select(.type == "user"))[0].message.content | strings' "$1"
}
transcribed() {
  local t m a q p
  for t in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}"/projects/*/*/subagents/agent-"$2".jsonl; do
    m=${t%.jsonl}.meta.json
    a=$(jq -r .agentType "$m") && critic "$a" && [ "${a##*:}" = "$1" ] &&
      [[ $(prompt "$t") = *$'\nFingerprint: '"$change" ]] &&
      q=$(jq -r .parentAgentId "$m") && [[ $q =~ ^[^/]+$ ]] && p=${t%/*}/agent-$q &&
      ours "$(jq -r .agentType "$p.meta.json")" impl &&
      jq -se --slurpfile m "$m" --slurpfile p "$p.meta.json" --arg c "$1" '$m[0].spawnDepth == $p[0].spawnDepth + 1 and
        any(.[] | select(.type == "assistant") | .message.content[]?; .type == "tool_use" and .id == $m[0].toolUseId and
          (.input.subagent_type | split(":")[-1]) == $c)' "$p.jsonl" >/dev/null &&
      [ "$(jq -rs '[.[] | select(.type == "assistant") | .message.content[]?] |
        (map(select(.name == "SubagentHandback"))[-1].input.message // map(select(.type == "text"))[-1].text // "")' "$t" |
        "$s/verdict")" = APPROVE ] && return
  done 2>/dev/null
  return 1
}
case $1 in
  spawn)
    i=$(cat)
    critic "$(jq -r '.tool_input.subagent_type // ""' <<<"$i")" || exit 0
    read -r w b _ <<<"$(jq -r '.tool_input.prompt // ""' <<<"$i")"
    [ -n "$b" ] && fingerprint "$w" "$b" || { echo "A critic's prompt must hold only your worktree's path and the root branch." >&2; exit 2; }
    jq -c --arg p "Worktree: $w"$'\nRoot Branch: '"$b"$'\nFingerprint: '"$change" '{hookSpecificOutput: {hookEventName: "PreToolUse", updatedInput: (.tool_input | .prompt = $p)}}' <<<"$i"
    exit ;;
  handback | record)
    i=$(cat)
    a=$(jq -r '.agent_type // ""' <<<"$i")
    critic "$a" || exit 0
    id=$(jq -r .agent_id <<<"$i")
    [[ $id =~ ^[^/]+$ ]] || { echo "$id: invalid agent ID" >&2; exit 1; }
    t=$(jq -r '.agent_transcript_path // ((.transcript_path | rtrimstr(".jsonl")) + "/subagents/agent-\(.agent_id).jsonl")' <<<"$i")
    p=$(prompt "$t") || exit 1
    re=$'^Worktree: ([^\n ]+)\nRoot Branch: ([^\n ]+)\nFingerprint: ([0-9a-f]+)$'
    [[ $p =~ $re ]] || { echo "$id: prompt not set by $0 spawn" >&2; exit 1; }
    f=${BASH_REMATCH[3]}
    fingerprint "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    [ ! -e "$d/$id" ] || exit 0
    k=.last_assistant_message
    [ "$1" = record ] || k=.tool_input.message
    m=$(jq -r "$k // \"\"" <<<"$i")
    printf %s "$m" | "$s/verdict" >/dev/null || { [ "$1" = record ] && jq -e .stop_hook_active <<<"$i" >/dev/null && exit 1; exit 2; }
    [ "$change" = "$f" ] || { echo "$w: changed during the review" >&2; exit 1; }
    mkdir -p "$d"
    printf '%s\n%s\n%s\n' "${a##*:}" "$change" "$m" >"$d/$id"
    ls -t "$d" | tail -n +101 | (cd "$d" && xargs -rd '\n' rm -f --)
    exit ;;
esac
fingerprint "$2" "$3"
fail=0
for f in "$h"/.claude/agents/*-critic.md; do
  c=$(basename "$f" .md) ok=
  for id in "${@:4}"; do
    [[ $id =~ ^[^/]+$ ]] && { read -r rc && read -r rf && [ "$rc $rf" = "$c $change" ] &&
      [ "$("$s/verdict")" = APPROVE ]; } 2>/dev/null <"$d/$id" && transcribed "$c" "$id" && ok=1
  done
  [ -n "$ok" ] || { echo "$c: no approval of the change as it stands" >&2; fail=1; }
done
exit "$fail"
