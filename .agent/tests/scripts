#!/usr/bin/env bash
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
scripts=$here/../scripts
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export PATH=$here/stub:$PATH
git init -q "$tmp/road"
issues=$tmp/road/.git/issues.json

same() { diff <(printf '%s\n' "$1") <(printf '%s\n' "$2"); }
road() { "$scripts/roadmap" gh "$tmp/road" "$@"; }
states() { jq -r '.[] | [.number, .state, .state_reason // "", .parent // "", .title, .body // ""] | @tsv' "$issues"; }
seed() {
  jq -n '[
    {number: 1, title: "one", body: "b1", state: "open", author_association: "OWNER",
     comments: [{body: "c1", author_association: "MEMBER"}, {body: "spam", author_association: "NONE"}]},
    {number: 2, title: "two", state: "open", author_association: "MEMBER", parent: 1},
    {number: 3, title: "three", state: "closed", state_reason: "completed", author_association: "OWNER", parent: 1},
    {number: 4, title: "four", state: "open", author_association: "CONTRIBUTOR"},
    {number: 5, title: "five", state: "open", author_association: "OWNER", pull_request: {}},
    {number: 6, title: "six", state: "open", author_association: "COLLABORATOR"},
    {number: 7, title: "seven", state: "closed", state_reason: "completed", author_association: "OWNER", parent: 6},
    {number: 8, title: "eight", state: "open", author_association: "OWNER", parent: 2},
    {number: 9, title: "nine", state: "open", author_association: "OWNER", parent: 6}
  ] | map({comments: []} + .)' >"$issues"
}

test_list() {
  seed
  same "$(road list)" $'1\tone\n2\ttwo\n6\tsix\n8\teight\n9\tnine'
}

test_candidates() {
  seed
  same "$(road candidates)" $'8\teight\n9\tnine'
  road close 9
  same "$(road candidates)" $'6\tsix\n8\teight'
}

test_descendants() {
  seed
  same "$(road descendants 1)" $'2\ttwo\n8\teight'
  same "$(road descendants 6)" $'9\tnine'
  same "$(road descendants 8)" ''
  jq '.[1].author_association = "NONE"' "$issues" >"$issues.new" && mv "$issues.new" "$issues"
  same "$(road descendants 1)" $'8\teight'
  road add t b 3 >/dev/null
  same "$(road descendants 1)" $'8\teight\n10\tt'
}

test_other_repo_subs() {
  seed
  jq '. + [
      {number: 10, title: "ten", state: "open", author_association: "OWNER", parent: 9, repository_url: "other"},
      {number: 11, title: "eleven", state: "open", author_association: "OWNER", parent: 10},
      {number: 12, title: "twelve", state: "open", author_association: "OWNER", parent: 6, repository_url: "other"}
    ]' "$issues" >"$issues.new" && mv "$issues.new" "$issues"
  same "$(road candidates)" $'8\teight\n9\tnine\n11\televen'
  same "$(road descendants 6)" $'9\tnine'
  road complete 9
  same "$(states | cut -f 1-3 | sed -n '6p;9,12p')" $'6\tclosed\tcompleted\n9\tclosed\tcompleted\n10\topen\t\n11\topen\t\n12\topen\t'
  road complete 11
  same "$(states | cut -f 1-3 | sed -n 10,11p)" $'10\topen\t\n11\tclosed\tcompleted'
}

test_show() {
  seed
  same "$(road show 1)" $'one\n\nb1\n\nc1'
  same "$(road show 2)" two
  same "$(road show 4)" ''
}

test_add() {
  seed
  same "$(road add t b)" 10
  same "$(road add u c 1)" 11
  same "$(states | tail -2)" $'10\topen\t\t\tt\tb\n11\topen\t\t1\tu\tc'
}

test_edit() {
  seed
  road edit 1 uno
  same "$(states | head -1)" $'1\topen\t\t\tuno\tb1'
  road edit 1 eins ''
  same "$(states | head -1)" $'1\topen\t\t\teins\t'
}

test_close() {
  seed
  road close 1
  same "$(states | head -3 | cut -f 1-3)" $'1\tclosed\tnot_planned\n2\tclosed\tnot_planned\n3\tclosed\tcompleted'
  same "$(states | sed -n 8p | cut -f 1-3)" $'8\tclosed\tnot_planned'
}

test_complete() {
  seed
  road complete 8
  same "$(states | cut -f 1-3 | sed -n '1,3p;8p')" $'1\tclosed\tcompleted\n2\tclosed\tcompleted\n3\tclosed\tcompleted\n8\tclosed\tcompleted'
  road complete 9
  same "$(states | cut -f 1-3 | sed -n '6p;9p')" $'6\tclosed\tcompleted\n9\tclosed\tcompleted'
  seed
  road complete 1
  same "$(states | cut -f 1-3 | sed -n '1,3p;8p')" $'1\tclosed\tcompleted\n2\tclosed\tnot_planned\n3\tclosed\tcompleted\n8\tclosed\tnot_planned'
}

test_approved() {
  jq -n '[
      {number: 1, labels: [{name: "ok"}, {name: "approved"}]},
      {number: 2, labels: [{name: "ok"}], parent: 1}
    ]' >"$issues"
  same "$(for n in 1 2; do road approved "$n" && echo "$n"; done)" 1
}

test_poll() {
  local state=$tmp/road/.git/roadmap-poll
  poll() { PATH=$tmp/bin:$PATH "$scripts/poll" gh "$tmp/road"; }
  mkdir -p "$tmp/bin"
  printf '#!/bin/sh\necho "$1" >>"%s"\n' "$tmp/slept" >"$tmp/bin/sleep"
  chmod +x "$tmp/bin/sleep"
  seed
  rm -f "$state" "$tmp/slept"
  for _ in 1 2 3 4 5 6; do same "$(poll)" $'8\teight\n9\tnine'; done
  road edit 9 nueve
  same "$(poll)" $'8\teight\n9\tnueve'
  poll >/dev/null
  mv "$issues" "$issues.bak"
  same "$(poll 2>/dev/null; echo $?)" 1
  poll 2>/dev/null && return 1
  mv "$issues.bak" "$issues"
  poll >/dev/null
  poll >/dev/null
  for w in junk 0 08; do echo "$w" >"$state"; poll >/dev/null; done
  rm "$state"
  mkdir "$state"
  same "$(poll 2>/dev/null)" $'8\teight\n9\tnueve'
  same "$(paste -sd ' ' "$tmp/slept")" '30 30 60 120 240 480 480 30 60 120 240 480 30 30 30 30'
}

test_lead_stop_hook() {
  local cmd
  [[ $(yq --help 2>&1) == *'jq wrapper'* ]] || { echo 'test_lead_stop_hook needs yq, the Python jq wrapper' >&2; return 1; }
  cmd=$(awk 'NR > 1 && /^---$/ {exit} NR > 1' "$here/../../.claude/commands/lead.md" |
    yq -r '[.hooks.Stop[].hooks[].command] | if length == 1 then .[0] else error("not one Stop hook") end')
  hook() { jq -n "$1" | sh -c "$cmd" 2>&1; echo $?; }
  local block=$'Continue the Lead Loop, or end your message with the line "Awaiting user." to yield to the user.\n2'
  same "$(hook '{last_assistant_message: "Proceed?\n\n1. Abort\n2. Replace\n\nAwaiting user.\n"}')" 0
  same "$(hook '{last_assistant_message: "Awaiting user."}')" 0
  same "$(hook '{last_assistant_message: "Proceed?\n\n1. Abort\n2. Replace"}')" "$block"
  same "$(hook '{last_assistant_message: "Awaiting user.\nNone remain."}')" "$block"
  same "$(hook '{last_assistant_message: "Not Awaiting user."}')" "$block"
  same "$(hook '{}')" "$block"
  same "$(hook '{last_assistant_message: "Waiting.", background_tasks: [{status: "running"}]}')" 0
  same "$(hook '{last_assistant_message: "Waiting.", background_tasks: []}')" "$block"
}

harness() {
  rm -rf "$tmp/harness"
  mkdir -p "$tmp/harness/.agent"
  cp -r "$scripts" "$tmp/harness/.agent/scripts"
  cp -r "$here/../schemas" "$tmp/harness/.agent/schemas"
  sed "$1" "$here/../schemas/${2:-governance-schema}.md" >"$tmp/harness/.agent/schemas/${2:-governance-schema}.md"
}

test_governance_growth() {
  local r=$tmp/growth w=$tmp/growth-work
  growth() { (cd "$1" && "${3:-$scripts}/governance-growth" work "$2"); }
  at() { git -C "$1" -c user.name=t -c user.email=t@t "${@:2}"; }
  git init -q -b main "$r"
  jq -n '[{number: 1, labels: [{name: "approved"}]}, {number: 2, labels: []}]' >"$r/.git/issues.json"
  echo 'a b c' >"$r/CLAUDE.md"
  at "$r" add . && at "$r" commit -qm a
  at "$r" worktree add -q -b work "$w"
  mkdir -p "$w/.claude/agents" "$r/sub"
  echo 'd e' >"$w/.claude/agents/x.md"
  echo 'not governed by default' >"$w/notes.md"
  at "$w" add . && at "$w" commit -qm b
  same "$(growth "$r" 2)" 2
  same "$(growth "$r/sub" 2)" 2
  same "$(growth "$w" 2)" 2
  harness '/^## Governed Documents$/{n;s/.*/`notes.md` in this harness/}'
  same "$(growth "$r" 1 "$tmp/harness/.agent/scripts")" 4
  harness '/^## Governed Documents$/{n;s/.*/none/}'
  same "$(growth "$r" 1 "$tmp/harness/.agent/scripts" 2>&1; echo $?)" \
    "$tmp/harness/.agent/scripts/../schemas/governance-schema.md: no docs"$'\n1'
  growth "$r" 2 >/dev/null && return 1
  growth "$r" 1 >/dev/null
  echo a >"$w/CLAUDE.md"
  at "$w" commit -qam c
  echo 'f g' >>"$r/CLAUDE.md"
  at "$r" commit -qam d
  same "$(growth "$r" 2)" 0
  growth "$r" 2 >/dev/null
}

test_unknown_operation() {
  seed
  road bogus && return 1
  [ $? = 2 ]
}

test_verdict() {
  local input expected
  while IFS='|' read -r input expected; do
    same "$(printf "$input" | "$scripts/verdict" 2>&1)" "$expected"
  done <<'EOF'
Verdict: APPROVE|APPROVE
\nVerdict: APPROVE \nFindings:\n- f\n\n- g|APPROVE
Verdict: REJECT\nRejection Grounds: r\nFindings:\n- f|REJECT
Verdict: REJECT|line 1: REJECT needs Rejection Grounds
Verdict: APPROVE\nRejection Grounds: None|line 2: APPROVE must omit Rejection Grounds
Verdict: REJECT\nFindings: f\nRejection Grounds: r|line 3: Rejection Grounds and Findings each appear at most once, in that order
Verdict: REJECT\nRejection Grounds:\nFindings: f|line 2: Rejection Grounds is empty
Verdict: APPROVE\nFindings:|line 2: Findings is empty
Verdict: APPROVE\nstray|line 2: text must be under Rejection Grounds or Findings
Verdict: APPROVE\nFindings: f\nFindings: g|line 3: Rejection Grounds and Findings each appear at most once, in that order
preamble\nVerdict: APPROVE|line 1: first line must be Verdict: APPROVE or Verdict: REJECT
Verdict: approve|line 1: first line must be Verdict: APPROVE or Verdict: REJECT
EOF
}

test_review() {
  local r=$tmp/rev w=$tmp/rev-wt o p
  at() { git -C "$1" -c user.name=t -c user.email=t@t "${@:2}"; }
  hook() { "$scripts/review" "$@" 2>&1; echo $?; }
  spawn() { jq -n --arg t "$1" --arg p "$2" '{tool_input: {subagent_type: $t, prompt: $p, description: "d"}}' | hook "${3-spawn}"; }
  prompt() { spawn "$1" "$w main" | jq -r 'objects | .hookSpecificOutput.updatedInput.prompt'; }
  send() {
    local t=$tmp/rev-session/subagents/agent-$3.jsonl
    mkdir -p "${t%/*}"
    jq -nc --arg p "${P-$(prompt "$2")}" '{type: "user", message: {role: "user", content: $p}}' >"$t"
    jq -n --arg e "$1" --arg a "$2" --arg i "$3" --arg m "$4" --arg s "$tmp/rev-session.jsonl" \
      "{agent_type: \$a, agent_id: \$i, transcript_path: \$s} + if \$e == \"record\" then
      {last_assistant_message: \$m, stop_hook_active: false} else {tool_input: {message: \$m}} end | ${X-.}" |
      hook "$1"
  }
  record() { send record "$@"; }
  handback() { send handback "$@"; }
  approved() { hook approved "$w" main "$@"; }
  objs() { find "$r/.git/objects" -type f | sort; }
  git init -q -b main "$r"
  seq 20 >"$r/a"
  echo old >"$r/old"
  at "$r" add . && at "$r" commit -qm a
  at "$r" worktree add -q -b work "$w"
  at "$r" config color.ui always
  sed -i '10a x' "$w/a"
  printf 'a\0' >"$w/bin"
  mv "$w/old" "$w/0new"
  o=$(objs)
  same "$(cd "$tmp" && spawn agent-harness:earn-its-place-critic $'rev-wt main extra\nmore' |
    sed '1s/[0-9a-f]\{40\}"/F"/')" "$(jq -nc --arg p "$w main"$'\nFingerprint: F' '{hookSpecificOutput: {hookEventName: "PreToolUse",
      updatedInput: {subagent_type: "agent-harness:earn-its-place-critic", prompt: $p, description: "d"}}}')"$'\n0'
  for t in impl ../x-critic x-critic other:full-review-critic ''; do same "$(spawn "$t" junk)" 0; done
  local bad="A critic's prompt must hold only your worktree's path and the root branch."$'\n2'
  same "$(spawn full-review-critic "$w")" "$bad"
  same "$(spawn full-review-critic "$tmp/none main" | tail -n 2)" "$bad"
  same "$(spawn full-review-critic "$w none" | tail -n 2)" "$bad"
  same "$(record earn-its-place-critic e 'Verdict: APPROVE')" 0
  same "$(record full-review-critic x 'Approved.')" $'line 1: first line must be Verdict: APPROVE or Verdict: REJECT\n2'
  same "$(X='.stop_hook_active = true' record full-review-critic x 'Approved.')" $'line 1: first line must be Verdict: APPROVE or Verdict: REJECT\n1'
  same "$(P="$w main" record full-review-critic x 'Verdict: APPROVE')" "x: prompt not set by $scripts/review spawn"$'\n1'
  p=$(prompt full-review-critic)
  touch "$w/during"
  same "$(P=$p record full-review-critic x 'Verdict: APPROVE')" "$w: changed during the review"$'\n1'
  rm "$w/during"
  same "$(record full-review-critic ../x 'Verdict: APPROVE')" $'../x: invalid agent ID\n1'
  for t in impl other:full-review-critic; do same "$(P=$p record "$t" x 'Verdict: APPROVE')" 0; done
  [ ! -e "$r/.git/critic-reviews/x" ]
  same "$(X='.stop_hook_active = true' handback agent-harness:alignment-critic l 'Approved.')" \
    $'line 1: first line must be Verdict: APPROVE or Verdict: REJECT\n2'
  same "$(handback other:alignment-critic l 'Verdict: APPROVE')" 0
  same "$(X='.transcript_path = "/none.jsonl"' handback alignment-critic l 'Approved.' | tail -n 1)" 1
  same "$(P="$tmp/none main"$'\nFingerprint: 0' handback alignment-critic l 'Approved.' | tail -n 1)" 1
  [ ! -e "$r/.git/critic-reviews/l" ]
  same "$(record alignment-critic l $'Verdict: REJECT\nRejection Grounds: r')" 0
  same "$(handback alignment-critic l 'Verdict: APPROVE')" 0
  same "$(record alignment-critic l 'Done.')" 0
  same "$(sed -n '1p;3,$p' "$r/.git/critic-reviews/l")" $'alignment-critic\nVerdict: APPROVE'
  same "$(spawn x x run | tail -n 1)" 2
  same "$(approved | tail -n 1)" 2
  record full-review-critic f $'Verdict: REJECT\nRejection Grounds: r' >/dev/null
  same "$(approved e l f)" $'full-review-critic: no approval of the change as it stands\n1'
  record agent-harness:full-review-critic g 'Verdict: APPROVE' >/dev/null
  same "$(approved e l g x ../e)" 0
  at "$r" config core.abbrev 4
  printf '54438\0' >"$w/bin"
  same "$(approved e l g | tail -n 1)" 1
  printf 'a\0' >"$w/bin"
  same "$(objs)" "$o"
  same "$(approved e g)" $'alignment-critic: no approval of the change as it stands\n1'
  sed -i '2a y' "$r/a"
  at "$r" commit -qam b
  at "$w" add -A
  at "$w" commit -qm c
  at "$w" merge -q --no-edit main >/dev/null
  same "$(approved e l g)" 0
  stale() { same "$(approved e l g | tail -n 1)" 1; }
  sed -i '12d; 15a x' "$w/a"
  stale
  at "$w" checkout -q a
  chmod +x "$w/a"
  stale
  chmod -x "$w/a"
  at "$w" mv a moved
  stale
  at "$w" mv moved a
  printf 'b\0' >"$w/bin"
  stale
  printf 'a\0' >"$w/bin"
  touch "$w/new"
  stale
  rm "$w/new"
  same "$(approved e l g)" 0
  for i in $(seq 100); do touch -d @0 "$r/.git/critic-reviews/old$i"; done
  record alignment-critic n 'Verdict: APPROVE' >/dev/null
  same "$(ls "$r/.git/critic-reviews" | wc -l)" 100
  same "$(approved e n g)" 0
}

test_plugin_loads() {
  local root=$here/../.. m=$tmp/market out c
  for c in agents commands; do claude plugin validate --strict "$(readlink -f "$root/$c")" >/dev/null; done
  mkdir -p "$m/.claude-plugin" "$m/p/.claude-plugin" "$m/p/agents"
  jq -n '{name: "m", owner: {name: "t"}, plugins: [{name: "agent-harness", source: "./p"}]}' >"$m/.claude-plugin/marketplace.json"
  echo '{"name": "agent-harness"}' >"$m/p/.claude-plugin/plugin.json"
  printf -- '---\nname: x-critic\ndescription: x\n---\nx\n' >"$m/p/agents/x-critic.md"
  export CLAUDE_CONFIG_DIR=$tmp/config
  claude plugin marketplace add "$m" >/dev/null
  claude plugin install agent-harness@m >/dev/null
  out=$(claude --plugin-dir "$root" plugin details agent-harness)
  loaded() { sed -n "s/^  $1 ([0-9]*)  //p" <<<"$out" | sed 's/  (.*//; s/, /\n/g' | sort; }
  names() { ls "$root/.claude/$1" | sed -n 's/\.md$//p' | sort; }
  same "$(sed -n 2p <<<"$out")" '  Source: agent-harness@inline'
  same "$(loaded Agents)" "$(names agents)"
  same "$(loaded Skills)" "$(names commands)"
  same "$(loaded Hooks)" "$(jq -r '.hooks | keys[]' "$root/.claude/settings.json" | sort)"
}

governed() {
  rm -rf "$tmp/repo"
  mkdir -p "$tmp/repo/.agent/scripts" "$tmp/repo/.claude/agents"
  printf '%b' "$1" >"$tmp/repo/$2"
}

rejects() {
  local out status=0
  out=$("$scripts/check" "$tmp/repo") || status=$?
  [ "$status" != 0 ] && same "$out" "$1"
}

test_check() {
  "$scripts/check" "$here/../.."
  same "$("$scripts/check" 2>&1; echo $?)" "usage: $scripts/check <repo path>"$'\n2'
  governed '# Invariants\n\n## A\nx\n```\n# Notes\n```\n' CLAUDE.md
  "$scripts/check" "$tmp/repo"
  governed '---\nname: a\n---\n# Definitions\n## A\nx\n' .claude/agents/a.md
  "$scripts/check" "$tmp/repo"
  governed 'x\n# Invariants\n' CLAUDE.md
  rejects CLAUDE.md:1
  governed '# Invariants\n# Notes\n' CLAUDE.md
  rejects CLAUDE.md:2
  governed '---\nname: a\n# Invariants\n' .claude/agents/a.md
  rejects .claude/agents/a.md:3
  governed 'case $1 in\n  list | show | add | edit | close | complete) ;;\nesac\n' .agent/scripts/roadmap-x
  rejects $'.agent/scripts/roadmap-x: not executable\n.agent/scripts/roadmap-x: candidates\n.agent/scripts/roadmap-x: descendants'
  local h=$tmp/harness/.agent
  local f t v
  for s in governance-schema:Categories:cats 'roadmap:Roadmap Operations:ops' 'governance-schema:Governed Documents:docs'; do
    IFS=: read -r f t v <<<"$s"
    harness "s/^## $t\$/## X/" "$f"
    same "$("$h/scripts/check" "$tmp/repo"; echo $?)" "$h/scripts/../schemas/$f.md: no $v"$'\n1'
  done
}

test_change_under_review() {
  local r=$tmp/cur
  rm -rf "$r"
  git init -q -b main "$r"
  echo old >"$r/a"
  echo ignored >"$r/.gitignore"
  git -C "$r" add . && git -C "$r" -c user.name=t -c user.email=t@t commit -qm a
  git -C "$r" checkout -qb work
  echo new >"$r/a"
  git -C "$r" -c user.name=t -c user.email=t@t commit -qam b
  echo added >"$r/b"
  echo x >"$r/ignored"
  echo next >>"$r/a"
  same "$("$scripts/change-under-review" "$r" main | grep '^[-+][^-+]')" $'-old\n+new\n+next\n+added'
}

fail=0
for t in $(declare -F | awk '$3 ~ /^test_/ {print $3}'); do
  (set -e; "$t")
  [ $? = 0 ] || { echo "$t"; fail=1; }
done
exit "$fail"
