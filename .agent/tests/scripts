#!/usr/bin/env bash
set -uo pipefail
here=$(cd "$(dirname "$0")" && pwd)
scripts=$here/../scripts
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export PATH=$here/stub:$PATH
git init -q "$tmp/road"
issues=$tmp/road/.git/issues.json

same() { diff <(printf '%s\n' "$1") <(printf '%s\n' "$2"); }
road() { "$scripts/roadmap" gh "$tmp/road" "$@"; }
states() { jq -r '.[] | [.number, .state, .state_reason // "", .parent // "", .title, .body // ""] | @tsv' "$issues"; }
seed() {
  jq -n '[
    {number: 1, title: "one", body: "b1", state: "open", author_association: "OWNER",
     comments: [{body: "c1", author_association: "MEMBER"}, {body: "spam", author_association: "NONE"}]},
    {number: 2, title: "two", state: "open", author_association: "MEMBER", parent: 1},
    {number: 3, title: "three", state: "closed", state_reason: "completed", author_association: "OWNER", parent: 1},
    {number: 4, title: "four", state: "open", author_association: "CONTRIBUTOR"},
    {number: 5, title: "five", state: "open", author_association: "OWNER", pull_request: {}},
    {number: 6, title: "six", state: "open", author_association: "COLLABORATOR"},
    {number: 7, title: "seven", state: "closed", state_reason: "completed", author_association: "OWNER", parent: 6},
    {number: 8, title: "eight", state: "open", author_association: "OWNER", parent: 2},
    {number: 9, title: "nine", state: "open", author_association: "OWNER", parent: 6}
  ] | map({comments: [], labels: []} + .)' >"$issues"
}

test_list() {
  seed
  same "$(road list)" $'1\tone\n2\ttwo\n6\tsix\n8\teight\n9\tnine'
}

test_candidates() {
  seed
  same "$(road candidates)" $'8\teight\n9\tnine'
  road close 9
  same "$(road candidates)" $'6\tsix\n8\teight'
}

test_descendants() {
  seed
  same "$(road descendants 1)" $'2\ttwo\n8\teight'
  same "$(road descendants 6)" $'9\tnine'
  same "$(road descendants 8)" ''
  jq '.[1].author_association = "NONE"' "$issues" >"$issues.new" && mv "$issues.new" "$issues"
  same "$(road descendants 1)" $'8\teight'
  road add t b 3 >/dev/null
  same "$(road descendants 1)" $'8\teight\n10\tt'
}

test_other_repo_subs() {
  seed
  jq '. + [
      {number: 10, title: "ten", state: "open", author_association: "OWNER", parent: 9, repository_url: "other"},
      {number: 11, title: "eleven", state: "open", author_association: "OWNER", parent: 10},
      {number: 12, title: "twelve", state: "open", author_association: "OWNER", parent: 6, repository_url: "other"}
    ]' "$issues" >"$issues.new" && mv "$issues.new" "$issues"
  same "$(road candidates)" $'8\teight\n9\tnine\n11\televen'
  same "$(road descendants 6)" $'9\tnine'
  road complete 9
  same "$(states | cut -f 1-3 | sed -n '6p;9,12p')" $'6\tclosed\tcompleted\n9\tclosed\tcompleted\n10\topen\t\n11\topen\t\n12\topen\t'
  road complete 11
  same "$(states | cut -f 1-3 | sed -n 10,11p)" $'10\topen\t\n11\tclosed\tcompleted'
}

test_show() {
  seed
  same "$(road show 1)" $'one\n\nb1\n\nc1'
  same "$(road show 2)" two
  same "$(road show 4)" ''
}

test_add() {
  seed
  same "$(road add t b)" 10
  same "$(road add u c 1)" 11
  same "$(states | tail -2)" $'10\topen\t\t\tt\tb\n11\topen\t\t1\tu\tc'
}

test_edit() {
  seed
  road edit 1 uno
  same "$(states | head -1)" $'1\topen\t\t\tuno\tb1'
  road edit 1 eins ''
  same "$(states | head -1)" $'1\topen\t\t\teins\t'
}

test_close() {
  seed
  road close 1
  same "$(states | head -3 | cut -f 1-3)" $'1\tclosed\tnot_planned\n2\tclosed\tnot_planned\n3\tclosed\tcompleted'
  same "$(states | sed -n 8p | cut -f 1-3)" $'8\tclosed\tnot_planned'
}

test_complete() {
  seed
  road complete 8
  same "$(states | cut -f 1-3 | sed -n '1,3p;8p')" $'1\tclosed\tcompleted\n2\tclosed\tcompleted\n3\tclosed\tcompleted\n8\tclosed\tcompleted'
  road complete 9
  same "$(states | cut -f 1-3 | sed -n '6p;9p')" $'6\tclosed\tcompleted\n9\tclosed\tcompleted'
  seed
  road complete 1
  same "$(states | cut -f 1-3 | sed -n '1,3p;8p')" $'1\tclosed\tcompleted\n2\tclosed\tnot_planned\n3\tclosed\tcompleted\n8\tclosed\tnot_planned'
  seed
  road add t b 3 >/dev/null
  road complete 3
  same "$(states | cut -f 1-3 | sed -n '1,3p;10p')" $'1\topen\t\n2\topen\t\n3\tclosed\tcompleted\n10\tclosed\tnot_planned'
}

test_approved() {
  jq -n '[
      {number: 1, labels: [{name: "ok"}, {name: "approved"}]},
      {number: 2, labels: [{name: "ok"}], parent: 1}
    ]' >"$issues"
  same "$(for n in 1 2; do road approved "$n" && echo "$n"; done)" 1
  road approved 3 2>/dev/null && return 1
  [ $? = 2 ]
}

test_poll() {
  local state=$tmp/road/.git/roadmap-poll
  poll() { PATH=$tmp/bin:$PATH "$scripts/poll" gh "$tmp/road"; }
  on() { printf '%s\n' "$1" >"$tmp/on-third"; rm -f "$tmp/slept"; }
  mkdir -p "$tmp/bin"
  printf '#!/bin/sh\necho "$1" >>"%s"\nn=$(wc -l <"%s")\n[ "$n" != 3 ] || sh "%s"\n[ "$n" -lt 9 ]\n' \
    "$tmp/slept" "$tmp/slept" "$tmp/on-third" >"$tmp/bin/sleep"
  printf '#!/bin/sh\ncase "$*" in *approved*) ! grep -qx "$(wc -l <"%s")" "%s" 2>/dev/null || exit 1 ;; esac\nexec "%s" "$@"\n' \
    "$tmp/slept" "$tmp/down" "$here/stub/gh" >"$tmp/bin/gh"
  chmod +x "$tmp/bin/sleep" "$tmp/bin/gh"
  seed
  rm -f "$state"
  on :
  same "$(poll)" $'8\teight\n9\tnine'
  same "$(cat "$tmp/slept")" 30
  on "$scripts/roadmap gh $tmp/road edit 9 nueve"
  same "$(poll)" $'8\teight\n9\tnueve'
  mv "$issues" "$issues.bak"
  on "mv $issues.bak $issues; $scripts/roadmap gh $tmp/road close 8"
  same "$(poll 2>/dev/null)" $'2\ttwo\n9\tnueve'
  on "jq '.[8].labels = [{name: \"approved\"}]' $issues >$issues.new && mv $issues.new $issues"
  same "$(poll)" $'2\ttwo\n9\tnueve'
  on "jq '.[8].comments = [{body: \"unblocked\", author_association: \"OWNER\"}]' $issues >$issues.new && mv $issues.new $issues"
  same "$(poll)" $'2\ttwo\n9\tnueve'
  cp "$issues" "$issues.bak"
  road close 1
  road close 6
  on "cp $issues.bak $issues"
  same "$(poll)" $'2\ttwo\n9\tnueve'
  same "$(paste -sd ' ' "$tmp/slept")" '30 30 30'
  printf '%s\n' 1 2 3 5 6 7 8 >"$tmp/down"
  on :
  same "$(poll; echo $?)" 0
  seq 9 >"$tmp/down"
  on :
  same "$(poll; echo $?)" 1
  same "$(wc -l <"$tmp/slept")" 5
  rm "$tmp/down"
  rm "$state"
  mkdir "$state"
  same "$(poll 2>/dev/null)" $'2\ttwo\n9\tnueve'
}

test_lead_stop_hook() {
  local cmd
  [[ $(yq --help 2>&1) == *'jq wrapper'* ]] || { echo 'test_lead_stop_hook needs yq, the Python jq wrapper' >&2; return 1; }
  cmd=$(awk 'NR > 1 && /^---$/ {exit} NR > 1' "$here/../../.claude/commands/lead.md" |
    yq -r '[.hooks.Stop[].hooks[].command] | if length == 1 then .[0] else error("not one Stop hook") end')
  hook() { jq -n "$1" | sh -c "$cmd" 2>&1; echo $?; }
  local block=$'Continue the Lead Loop, or end your message with the line "Awaiting user." to yield to the user.\n2'
  same "$(hook '{last_assistant_message: "Proceed?\n\n1. Abort\n2. Replace\n\nAwaiting user.\n"}')" 0
  same "$(hook '{last_assistant_message: "Awaiting user."}')" 0
  same "$(hook '{last_assistant_message: "Proceed?\n\n1. Abort\n2. Replace"}')" "$block"
  same "$(hook '{last_assistant_message: "Awaiting user.\nNone remain."}')" "$block"
  same "$(hook '{last_assistant_message: "Not Awaiting user."}')" "$block"
  same "$(hook '{}')" "$block"
  same "$(hook '{last_assistant_message: "Waiting.", background_tasks: [{status: "running"}]}')" 0
  same "$(hook '{last_assistant_message: "Waiting.", background_tasks: []}')" "$block"
}

harness() {
  rm -rf "$tmp/harness"
  mkdir -p "$tmp/harness/.agent"
  cp -r "$scripts" "$tmp/harness/.agent/scripts"
  cp -r "$here/../schemas" "$tmp/harness/.agent/schemas"
  sed "$1" "$here/../schemas/${2:-governance-schema}.md" >"$tmp/harness/.agent/schemas/${2:-governance-schema}.md"
}

test_governance_growth() {
  local r=$tmp/growth w=$tmp/growth-work
  growth() { (cd "$1" && "${3:-$scripts}/governance-growth" work "$2"); }
  at() { git -C "$1" -c user.name=t -c user.email=t@t "${@:2}"; }
  git init -q -b main "$r"
  jq -n '[{number: 1, labels: [{name: "approved"}]}, {number: 2, labels: []}]' >"$r/.git/issues.json"
  echo 'a b c' >"$r/AGENTS.md"
  at "$r" add . && at "$r" commit -qm a
  at "$r" worktree add -q -b work "$w"
  mkdir -p "$w/.claude/agents" "$r/sub"
  echo 'd e' >"$w/.claude/agents/x.md"
  echo 'not governed by default' >"$w/notes.md"
  at "$w" add . && at "$w" commit -qm b
  same "$(growth "$r" 2)" 2
  same "$(growth "$r/sub" 2)" 2
  same "$(growth "$w" 2)" 2
  harness '/^## Governed Documents$/{n;s/.*/`notes.md` in this harness/}'
  same "$(growth "$r" 1 "$tmp/harness/.agent/scripts")" 4
  harness '/^## Governed Documents$/{n;s/.*/none/}'
  same "$(growth "$r" 1 "$tmp/harness/.agent/scripts" 2>&1; echo $?)" \
    "$tmp/harness/.agent/scripts/../schemas/governance-schema.md: no docs"$'\n1'
  growth "$r" 2 >/dev/null && return 1
  growth "$r" 1 >/dev/null
  echo a >"$w/AGENTS.md"
  at "$w" commit -qam c
  echo 'f g' >>"$r/AGENTS.md"
  at "$r" commit -qam d
  same "$(growth "$r" 2)" 0
  growth "$r" 2 >/dev/null
}

test_unknown_operation() {
  seed
  road bogus && return 1
  [ $? = 2 ]
}

test_verdict() {
  local input expected
  while IFS='|' read -r input expected; do
    same "$(printf "$input" | "$scripts/verdict" 2>&1)" "$expected"
  done <<'EOF'
Verdict: APPROVE|APPROVE
\nVerdict: APPROVE \nFindings:\n- f\n\n- g|APPROVE
Verdict: REJECT\nRejection Grounds: r\nFindings:\n- f|REJECT
Verdict: REJECT|line 1: REJECT needs Rejection Grounds
Verdict: APPROVE\nRejection Grounds: None|line 2: APPROVE must omit Rejection Grounds
Verdict: REJECT\nFindings: f\nRejection Grounds: r|line 3: Rejection Grounds and Findings each appear at most once, in that order
Verdict: REJECT\nRejection Grounds:\nFindings: f|line 2: Rejection Grounds is empty
Verdict: APPROVE\nFindings:|line 2: Findings is empty
Verdict: APPROVE\nstray|line 2: text must be under Rejection Grounds or Findings
Verdict: APPROVE\nFindings: f\nFindings: g|line 3: Rejection Grounds and Findings each appear at most once, in that order
preamble\nVerdict: APPROVE|line 1: first line must be Verdict: APPROVE or Verdict: REJECT
Verdict: approve|line 1: first line must be Verdict: APPROVE or Verdict: REJECT
EOF
}

test_review() {
  local r=$tmp/rev w=$tmp/rev-wt o p
  export CLAUDE_CONFIG_DIR=$tmp/rev-config
  at() { git -C "$1" -c user.name=t -c user.email=t@t "${@:2}"; }
  hook() { "${R-$scripts}/review" "$@" 2>&1; echo $?; }
  spawn() { jq -n --arg t "$1" --arg p "$2" '{tool_input: {subagent_type: $t, prompt: $p, description: "d"}}' | hook "${3-spawn}"; }
  prompt() { spawn earn-its-place-critic "$w main" | jq -r 'objects | .hookSpecificOutput.updatedInput.prompt'; }
  send() {
    local s=$CLAUDE_CONFIG_DIR/projects/p/s
    local t=$s/subagents/agent-$3.jsonl
    [ "$1" = handback ] || t=${s}2/subagents/agent-$3.jsonl
    mkdir -p "${t%/*}"
    jq -n '{agentType: "impl", spawnDepth: 1}' >"${t%/*}/agent-i.meta.json"
    jq -nc --arg a "$2" --arg i "$3" '{type: "assistant", message: {content: [{type: "tool_use", id: "u\($i)", input: {subagent_type: $a}}]}}' \
      >>"${t%/*}/agent-i.jsonl"
    jq -n --arg a "$2" --arg i "$3" '{agentType: $a, parentAgentId: "i", spawnDepth: 2, toolUseId: "u\($i)"}' >"${t%.jsonl}.meta.json"
    jq -nc --arg e "$1" --arg p "${P-$(prompt)}" --arg m "$4" '{type: "user", message: {role: "user", content: $p}},
      {type: "assistant", message: {role: "assistant", content: [if $e == "record" then {type: "text", text: $m}
        else {type: "tool_use", name: "SubagentHandback", input: {message: $m}} end]}}' >"$t"
    jq -n --arg e "$1" --arg a "$2" --arg i "$3" --arg m "$4" --arg s "$s.jsonl" --arg t "$t" \
      "{agent_type: \$a, agent_id: \$i, transcript_path: \$s} + if \$e == \"record\" then
      {agent_transcript_path: \$t, last_assistant_message: \$m, stop_hook_active: false} else {tool_input: {message: \$m}} end | ${X-.}" |
      hook "$1"
  }
  record() { send record "$@"; }
  handback() { send handback "$@"; }
  approved() { hook approved "$w" main "$@"; }
  objs() { find "$r/.git/objects" -type f | sort; }
  git init -q -b main "$r"
  seq 20 >"$r/a"
  echo old >"$r/old"
  at "$r" add . && at "$r" commit -qm a
  at "$r" worktree add -q -b work "$w"
  at "$r" config color.ui always
  sed -i '10a x' "$w/a"
  printf 'a\0' >"$w/bin"
  mv "$w/old" "$w/0new"
  o=$(objs)
  local h='${CLAUDE_PLUGIN_ROOT}: '$(cd "$scripts/../.." && pwd)
  same "$(cd "$tmp" && spawn agent-harness:earn-its-place-critic $'rev-wt main extra\nmore' |
    sed '1s/[0-9a-f]\{40\}"/F"/')" "$(jq -nc --arg p "$h"$'\nWorktree: '"$w"$'\nRoot Branch: main\nFingerprint: F' '{hookSpecificOutput: {hookEventName: "PreToolUse",
      updatedInput: {subagent_type: "agent-harness:earn-its-place-critic", prompt: $p, description: "d"}}}')"$'\n0'
  for t in impl agent-harness:impl; do
    same "$(spawn "$t" "$r"$'\ny')" "$(jq -nc --arg t "$t" --arg p "$h"$'\n'"$r"$'\ny' '{hookSpecificOutput: {hookEventName: "PreToolUse",
      updatedInput: {subagent_type: $t, prompt: $p, description: "d"}}}')"$'\n0'
  done
  for p in "$r y" "rev"$'\ny' "$tmp/none"$'\ny'; do
    same "$(cd "$tmp" && spawn impl "$p")" "An impl's prompt must start with the target repo's path on its own line."$'\n2'
  done
  for t in other:impl ../x-critic x-critic other:full-review-critic ''; do same "$(spawn "$t" junk)" 0; done
  local bad="A critic's prompt must hold only your worktree's path and the root branch."$'\n2'
  same "$(spawn full-review-critic "$w")" "$bad"
  same "$(spawn full-review-critic "$tmp/none main" | tail -n 2)" "$bad"
  same "$(spawn full-review-critic "$w none" | tail -n 2)" "$bad"
  unapproved() { echo "$1: the latest review of the change as it stands is not an approval by $2"$'\n2'; }
  same "$(spawn alignment-critic "$w main")" "$(unapproved alignment-critic earn-its-place-critic)"
  local malformed=$'Verdict: APPROVE\nRejection Grounds: None' omit=$'line 2: APPROVE must omit Rejection Grounds'
  same "$(record earn-its-place-critic m "$malformed")" "$omit"$'\n2'
  same "$(X='.stop_hook_active = true' record earn-its-place-critic m "$malformed")" "$omit"$'\n1'
  same "$(spawn alignment-critic "$w main")" "$(unapproved alignment-critic earn-its-place-critic)"
  same "$(record earn-its-place-critic e 'Verdict: APPROVE')" 0
  same "$(spawn alignment-critic "$w main" | tail -n 1)" 0
  same "$(spawn full-review-critic "$w main")" "$(unapproved full-review-critic alignment-critic)"
  same "$(record full-review-critic x 'Approved.')" $'line 1: first line must be Verdict: APPROVE or Verdict: REJECT\n2'
  same "$(X='.stop_hook_active = true' record full-review-critic y 'Approved.')" $'line 1: first line must be Verdict: APPROVE or Verdict: REJECT\n1'
  same "$(hook wait "$w" y)" $'Approved.\n0'
  same "$(sed -n 2p "$r/.git/critic-reviews/y")" -
  same "$(P="$w main" record full-review-critic x 'Verdict: APPROVE')" "x: prompt not set by $scripts/review spawn"$'\n1'
  p=$(prompt)
  same "$(P=${p#*$'\n'} record full-review-critic x 'Verdict: APPROVE')" "x: prompt not set by $scripts/review spawn"$'\n1'
  touch "$w/during"
  same "$(P=$p record full-review-critic v 'Verdict: APPROVE')" "$w: changed during the review"$'\n1'
  rm "$w/during"
  same "$(sed -n 2p "$r/.git/critic-reviews/v")" -
  same "$(record full-review-critic ../x 'Verdict: APPROVE')" $'../x: invalid agent ID\n1'
  same "$(P=$p record other:full-review-critic x 'Verdict: APPROVE')" 0
  [ ! -e "$r/.git/critic-reviews/x" ]
  same "$(X='.stop_hook_active = true' handback agent-harness:alignment-critic l 'Approved.')" \
    $'line 1: first line must be Verdict: APPROVE or Verdict: REJECT\n2'
  same "$(handback other:alignment-critic l 'Verdict: APPROVE')" 0
  same "$(X='.transcript_path = "/none.jsonl"' handback alignment-critic l 'Approved.' | tail -n 1)" 1
  same "$(P="$h"$'\nWorktree: '"$tmp/none"$'\nRoot Branch: main\nFingerprint: 0' handback alignment-critic l 'Approved.' | tail -n 1)" 1
  [ ! -e "$r/.git/critic-reviews/l" ]
  local meta=$CLAUDE_CONFIG_DIR/projects/p/s2/subagents/agent
  jq -n '{agentType: "alignment-critic", finished: true}' >"$meta-k.meta.json"
  (sleep 1; record alignment-critic k $'Verdict: REJECT\nRejection Grounds: r' >/dev/null) &
  same "$(timeout 20 "$scripts/review" wait "$w" k)" $'Verdict: REJECT\nRejection Grounds: r'
  wait
  same "$(spawn alignment-critic "$w main")" "$(unapproved alignment-critic earn-its-place-critic)"
  record earn-its-place-critic e2 'Verdict: APPROVE' >/dev/null
  same "$(spawn alignment-critic "$w main" | tail -n 1)" 0
  record alignment-critic k2 $'Verdict: REJECT\nRejection Grounds: r' >/dev/null
  for id in ../k . .. .k; do same "$(hook wait "$w" "$id")" "$id: invalid review ID"$'\n1'; done
  for id in z i; do same "$(hook wait "$w" "$id")" "$id: no critic of ours has this ID"$'\n1'; done
  jq -n '{agentType: "agent-harness:alignment-critic", finished: true}' >"$meta-n.meta.json"
  touch -d '-2 min' "$meta-n.meta.json"
  same "$(hook wait "$w" n)" $'n: the critic stopped without its review being recorded\n1'
  jq -n '{agentType: "alignment-critic"}' >"$meta-u.meta.json"
  jq -n '{agentType: "general-purpose", parentAgentId: "u"}' >"$meta-c.meta.json"
  touch "$meta-c.jsonl"
  echo x >"$meta-b.meta.json"
  touch -d '-31 min' "$meta-u.meta.json"
  same "$(timeout -s INT 7 "$scripts/review" wait "$w" u; echo $?)" 124
  touch -d '-31 min' "$meta-c.meta.json" "$meta-c.jsonl"
  same "$(hook wait "$w" u)" $'u: the critic stopped without its review being recorded\n1'
  same "$(hook wait "$w" | tail -n 1)" 2
  same "$(handback alignment-critic k 'Verdict: APPROVE')" 0
  same "$(tail -n 1 "$r/.git/critic-reviews/k")" 'Rejection Grounds: r'
  same "$(spawn full-review-critic "$w main")" "$(unapproved full-review-critic alignment-critic)"
  same "$(handback alignment-critic l 'Verdict: APPROVE')" 0
  same "$(record alignment-critic l 'Done.')" 0
  same "$(sed -n '1p;3,$p' "$r/.git/critic-reviews/l")" $'alignment-critic\nVerdict: APPROVE'
  same "$(spawn agent-harness:full-review-critic "$w main" | tail -n 1)" 0
  same "$(spawn x x run | tail -n 1)" 2
  same "$(approved | tail -n 1)" 2
  record full-review-critic f $'Verdict: REJECT\nRejection Grounds: r' >/dev/null
  same "$(approved e l f)" $'full-review-critic: no approval of the change as it stands\n1'
  same "$(approved e l v)" $'full-review-critic: no approval of the change as it stands\n1'
  record agent-harness:full-review-critic g 'Verdict: APPROVE' >/dev/null
  same "$(approved e l g x ../e)" 0
  cp "$r/.git/critic-reviews/g" "$r/.git/critic-reviews/h"
  same "$(approved e l h)" $'full-review-critic: no approval of the change as it stands\n1'
  tamper() {
    local t=$CLAUDE_CONFIG_DIR/projects/p/s2/subagents/agent-$1
    cp "$t" "$t.bak"
    jq -c "$2" "$t.bak" >"$t"
    same "$(approved e l g | tail -n 1)" 1
    mv "$t.bak" "$t"
  }
  tamper g.meta.json '.agentType = "alignment-critic"'
  tamper g.meta.json '.agentType = "other:full-review-critic"'
  tamper g.meta.json '.parentAgentId = "g"'
  tamper g.meta.json 'del(.parentAgentId)'
  mkdir -p "$CLAUDE_CONFIG_DIR"/projects/p/s{2/subagents/agent-x,3/subagents}
  cp "$CLAUDE_CONFIG_DIR"/projects/p/s2/subagents/agent-i.* "$CLAUDE_CONFIG_DIR/projects/p/s3/subagents"
  tamper g.meta.json '.parentAgentId = "x/../../../s3/subagents/agent-i"'
  tamper i.meta.json '.agentType = "general-purpose"'
  tamper i.meta.json '.agentType = "other:impl"'
  tamper g.meta.json '.spawnDepth = 3'
  tamper g.meta.json '.toolUseId = "uz"'
  tamper i.meta.json '.spawnDepth = 2'
  tamper i.jsonl '.message.content[0].input.subagent_type |= sub("full"; "x")'
  tamper g.jsonl 'if .type == "user" then .message.content |= sub("[0-9a-f]$"; "x") else . end'
  tamper g.jsonl 'if .type == "assistant" then .message.content[0].text = "Verdict: REJECT\nRejection Grounds: r" else . end'
  same "$(approved e l g)" 0
  local ready=$'Verdict: READY\nApprovals: e, l, g\nUnhandled Findings:\n- f\nWorktree: '"$w"
  same "$(handback impl j "$ready")" "$w: not clean"$'\n2'
  same "$(handback impl j $'Verdict: NOT READY\nEscalation: x\nWorktree: w\nmore')" 0
  same "$(handback agent-harness:impl j $'\nVerdict: NOT READY\n\nEscalation:\n- x\nWorktree:\n- `w`\n')" 0
  same "$(handback impl j $'Verdict: NOT READY\nEscalation: x')" $'Worktree: missing\n2'
  same "$(handback impl j $'Note\nVerdict: NOT READY')" $'a report must start with Verdict:\n2'
  same "$(handback impl j $'Verdict: NOT READY\nWorktree: w\nEscalation: x')" $'Escalation: repeated or out of order\n2'
  same "$(handback impl j $'Verdict: NOT READY\nVerdict: NOT READY')" $'Verdict: repeated or out of order\n2'
  same "$(handback impl j $'Verdict: NOT READY\nEscalation:\nWorktree: w')" $'Escalation: empty\n2'
  same "$(handback impl j 'Verdict: DONE')" $'Verdict: must be READY or NOT READY\n2'
  same "$(handback impl j $'Verdict: NOT READY\nApprovals: e')" $'Approvals: not allowed when NOT READY\n2'
  same "$(handback impl j $'Verdict: NOT READY\nUnhandled Findings: f')" $'Unhandled Findings: not allowed when NOT READY\n2'
  same "$(handback impl j $'Verdict: READY\nApprovals: e\nEscalation: x\nWorktree: w')" $'Escalation: not allowed when READY\n2'
  same "$(handback impl j $'Verdict: READY\nWorktree: w')" $'Approvals: missing\n2'
  same "$(handback impl j $'Verdict: READY\nApprovals: e')" $'Worktree: missing\n2'
  same "$(handback other:impl j 'Done.')" 0
  same "$(record impl j 'Done.')" $'a report must start with Verdict:\n2'
  same "$(X='.stop_hook_active = true' record impl j 'Done.')" $'a report must start with Verdict:\n1'
  same "$(X='.agent_transcript_path |= sub("/s2/"; "/s/")' record impl j 'Done.')" $'a report must start with Verdict:\n2'
  ln -s "$w" "$tmp/rev-link"
  same "$(hook approved "$tmp/rev-link" refs/heads/main e l g)" 0
  at "$r" config core.abbrev 4
  printf '54438\0' >"$w/bin"
  same "$(approved e l g | tail -n 1)" 1
  printf 'a\0' >"$w/bin"
  same "$(objs)" "$o"
  same "$(approved e g)" $'alignment-critic: no approval of the change as it stands\n1'
  sed -i '2a y' "$r/a"
  at "$r" commit -qam b
  same "$(spawn earn-its-place-critic "$w main")" "$w: main is not merged"$'\n2'
  harness ''
  cp -r "$here/../../.claude" "$here/../../.claude-plugin" "$tmp/harness"
  sed -i '/^## Syncing Before Review$/,/^## /s/earn-its-place-critic/alignment-critic/' "$tmp/harness/.claude/agents/impl.md"
  same "$(R=$tmp/harness/.agent/scripts spawn earn-its-place-critic "$w main" | tail -n 1)" 0
  same "$(R=$tmp/harness/.agent/scripts spawn alignment-critic "$w main")" "$w: main is not merged"$'\n2'
  at "$w" add -A
  at "$w" commit -qm c
  at "$w" merge -q --no-edit main >/dev/null
  same "$(approved e l g)" 0
  stale() { same "$(approved e l g | tail -n 1)" 1; }
  sed -i '12d; 15a x' "$w/a"
  stale
  at "$w" checkout -q a
  chmod +x "$w/a"
  stale
  chmod -x "$w/a"
  at "$w" mv a moved
  stale
  at "$w" mv moved a
  printf 'b\0' >"$w/bin"
  stale
  printf 'a\0' >"$w/bin"
  touch "$w/new"
  stale
  rm "$w/new"
  same "$(approved e l g)" 0
  same "$(handback impl j "$ready")" 0
  same "$(X='.agent_transcript_path |= sub("/s2/"; "/s/")' record impl j 'Done.')" 0
  local bullets=$'\n- e\n- l\n- `g`' path=$'\n- `'"$w"'`'
  same "$(record impl j "${ready/ e, l, g/$bullets}")" 0
  same "$(record impl j "${ready/ $w/$path}")" 0
  same "$(handback impl j "${ready/l, /}")" $'alignment-critic: no approval of the change as it stands\n2'
  same "$(handback impl j "${ready/e, l, g/z}")" $'Approvals: no review found\n2'
  for i in $(seq 100); do touch -d @0 "$r/.git/critic-reviews/old$i"; done
  record alignment-critic n 'Verdict: APPROVE' >/dev/null
  same "$(ls "$r/.git/critic-reviews" | wc -l)" 100
  same "$(approved e n g)" 0
}

test_guard() {
  local c m e=$tmp/echo-gh sp="$tmp/with space" before no=$'Label or close no roadmap items.\n2'
  local prefix="export PATH=$(printf %q "$(cd "$scripts" && pwd)/impl-bin"):\"\$PATH\" AGENT_HARNESS_IMPL=''"$'\n'
  local s=$tmp/guard-config/s g
  guard() { jq -n --arg a "${2-impl}" --argjson t "$1" "{agent_type: \$a, tool_input: \$t}${X-}" | "$scripts/review" guard 2>&1; echo $?; }
  run() {
    local out
    out=$(guard "$(jq -n --arg c "$1" '{command: $c}')")
    [ "${out##*$'\n'}" = 0 ] || { echo "$out"; return; }
    (cd "${D-$tmp/road}" && PATH=${2:+$2:}$PATH bash -c "$(head -n 1 <<<"$out" | jq -r .hookSpecificOutput.updatedInput.command)" 2>&1)
    echo $?
  }
  mkdir -p "$e" "$sp"
  printf '#!/bin/sh\necho gh "$@"\ncase "$*" in *-) cat ;; esac\n' >"$e/gh"
  chmod +x "$e/gh"
  cp "$scripts/roadmap" "$scripts/roadmap-gh" "$sp"
  seed
  echo 'gh api -X PATCH repos/o/r/issues/2 -f state=closed' >"$tmp/road/close.sh"
  echo 'mutation{removeLabelsFromLabelable(input:{labelableId:"x",labelIds:["y"]}){clientMutationId}}' >"$tmp/road/q.graphql"
  before=$(states)
  for c in "$scripts/roadmap gh . close 2" "r=$scripts/roadmap; \$r gh . complete 8" "'$sp/roadmap' gh . close 2" \
    "true && $scripts/land gh . 1 w main e" 'gh issue close 3' 'gh issue -R o/r close 3' 'gh issue delete 3 --yes' \
    'gh issue edit 3 --add-label approved' 'gh issue edit 3 --remove-label approved' 'gh issue edit 3 --remove-label=approved' \
    'gh issue create -t t --label x' 'gh issue create -t t -b b -lapproved' 'gh api -X PATCH repos/o/r/issues/3 -f state=closed' \
    "echo '{\"state\": \"closed\"}' | gh api -X PATCH repos/o/r/issues/3 --input -" "gh api repos/o/r/issues/3 -f 'state=closed'" \
    'gh api repos/o/r/issues/3 --input - <<<'"'"'{"labels": ["x"]}'"'" 'gh api repos/o/r/issues/3/labels -f labels[]=x' \
    'gh api -X DELETE repos/o/r/issues/3/labels/approved' 'gh api graphql -F query=@q.graphql' \
    'gh api graphql -f query='"'"'mutation{updateIssue(input:{id:"x",state:CLOSED}){issue{id}}}'"'" \
    "curl -X PATCH https://api.github.com/repos/o/r/issues/3 -d '{\"state\": \"closed\"}'" \
    "python3 -c 'import requests; requests.post(\"https://api.github.com/repos/o/r/issues/3/labels\", json={\"labels\": [\"x\"]})'"; do
    same "$(run "$c")" "$no" || { echo "$c"; return 1; }
  done
  same "$(states)" "$before"
  for c in 'gh issue list -l approved' 'gh issue list --label approved' "gh api repos/o/r/issues --jq '.[].labels'" \
    "gh issue comment 3 -b 'close it; --add-label approved'" 'gh issue edit 3 --title "-l x"' 'gh issue view 3' \
    'gh api -X GET repos/o/r/issues -f state=closed' 'gh api graphql -f query="{repository{issues(states:CLOSED){nodes{labels{nodes{name}}}}}}"'; do
    same "$(run "$c" "$e")" "$(bash -c "echo $c")"$'\n0' || { echo "$c"; return 1; }
  done
  same "$(printf '{"title": "t"}\n' | run 'gh api repos/o/r/issues --input -' "$e")" $'gh api repos/o/r/issues --input -\n{"title": "t"}\n0'
  same "$(run "$scripts/roadmap gh . add 'Avoid gh issue close' 'roadmap gh . close 3; gh issue edit 3 --add-label x; state=closed' 1")" $'10\n0'
  for c in "cat $scripts/land" "grep -c complete $scripts/roadmap-gh" 'echo "gh issue close 3; curl -X PATCH api.github.com"'; do
    same "$(run "$c >/dev/null")" 0
  done
  same "$(guard '{"command": "gh issue close 3"}' '')" 0
  same "$(guard '{"command": "gh issue close 3"}' other:impl)" 0
  same "$(guard '{"command": "gh x"}' agent-harness:impl | head -n 1 | jq -r .hookSpecificOutput.updatedInput.command)" "${prefix}gh x"
  for c in 'sh close.sh' 'git status' 'make test' 'git log --grep=landing'; do
    same "$(guard "$(jq -n --arg c "$c" '{command: $c}')")" 0 || { echo "$c"; return 1; }
  done
  for g in n t w x; do git init -q "$tmp/guard-$g"; done
  git -C "$tmp/guard-t" remote add origin git@github.com:O/R.git
  git -C "$tmp/guard-w" remote add origin https://github.com/o/r
  git -C "$tmp/guard-x" remote add origin https://github.com/x/y.git
  mkdir -p "$s/subagents"
  jq -nc --arg p $'${CLAUDE_PLUGIN_ROOT}: h\n'"$tmp/guard-t"$'\nr' '{type: "user", message: {content: $p}}' >"$s/subagents/agent-g.jsonl"
  local X=" + {agent_id: \"g\", transcript_path: \"$s.jsonl\"}"
  for c in 'w:gh issue close 3' 'w:gh issue edit 3 --add-label x' 'w:gh api -X PATCH repos/{owner}/{repo}/issues/3 -f state=closed' \
    'x:gh issue close 3 -R O/R' 'x:gh issue close -Rgithub.com/o/r 3' 'x:GH_REPO=o/r gh issue close 3' \
    'x:gh api -X PATCH repos/o/r/issues/3 -f state=closed' 'n:gh api -X DELETE /repos/o/r/issues/3/labels/x'; do
    same "$(D=$tmp/guard-${c%%:*} run "${c#*:}" "$e")" "$no" || { echo "$c"; return 1; }
  done
  for c in 'n:gh issue close 3' 'x:gh issue close 3' 'x:gh api -X PATCH repos/{owner}/{repo}/issues/3 -f state=closed' \
    'w:gh issue close 3 --repo=x/y' 'w:GH_REPO=x/y gh issue close 3' 'w:gh api repos/x/y/issues/3/labels -f labels[]=z'; do
    same "$(D=$tmp/guard-${c%%:*} run "${c#*:}" "$e")" "$(bash -c "echo ${c#*:}" | sed 's/^GH_REPO=x\/y //')"$'\n0' || { echo "$c"; return 1; }
  done
  same "$(guard '{"state": "closed"}')" "$no"
  same "$(guard '{"labels": []}')" "$no"
  same "$(guard '{"method": "update", "state": "open", "body": "close"}')" 0
  m=$(jq -r '.hooks.PreToolUse[] | select(.hooks[].command | endswith("review guard")) | .matcher' "$here/../../.claude/settings.json")
  for c in Bash mcp__github__issue_write; do [[ $c =~ ^($m)$ ]]; done
  for c in Read mcp__github__issue_read; do [[ ! $c =~ ^($m)$ ]]; done
}

