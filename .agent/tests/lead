#!/usr/bin/env bash
set -euo pipefail
[ "${LEAD_SCENARIO-}" = 1 ] || exit 0
command -v ps >/dev/null
command -v flock >/dev/null
. "$(dirname "$0")/lib/scenario"
sed -i 's/shut "$s" not_planned/shut "$s" "$2"/' .agent/scripts/roadmap-gh
sed -i 's/wait < 240 ? wait \* 2 : 480/wait < 480 ? wait * 2 : 960/' .agent/scripts/poll
sed -i 's/\[ -x "$b" \]/[ -e "$b" ]/' .agent/scripts/check
sed -i 's/ --exclude-standard//' .agent/scripts/change-under-review
out=$(.agent/tests/scripts 2>&1) || :
[ "$(grep '^test_' <<<"$out" | paste -sd ' ')" = 'test_change_under_review test_check test_close test_complete test_poll' ] ||
  { printf '%s\n' "$out" >&2; exit 1; }
git commit -q --amend -a --no-edit
git tag -f seed >/dev/null
jq -n --arg due "$(date -d '+3 days' +%F)" '[
  {number: 1, author_association: "NONE", labels: [], title: "Remove `.agent/tests/stub`"},
  {number: 2, author_association: "MEMBER", labels: [], title: "Add a `## Naming` invariant to AGENTS.md"},
  {number: 3, author_association: "OWNER", labels: [{name: "approved"}], title: "Tidy roadmap-gh helpers"},
  {number: 4, author_association: "OWNER", labels: [{name: "approved"}], parent: 3,
   title: "Rename roadmap-gh `shut` to `close_tree` (blocked: until #2 is closed)"},
  {number: 5, author_association: "OWNER", labels: [{name: "approved"}], state: "closed", state_reason: "completed",
   title: "Give roadmap-gh a `close` operation"},
  {number: 6, author_association: "OWNER", labels: [{name: "approved"}],
   title: "Make `roadmap-gh close` close items as not planned (blocked: until #5 is closed)",
   body: "`.agent/tests/scripts` fails because `close` closes items as completed."},
  {number: 7, author_association: "OWNER", labels: [{name: "approved"}],
   title: "Make roadmap-gh close open sub-items as not planned",
   body: "`test_complete` in `.agent/tests/scripts` fails because `shut`, which `close` and `complete` call, closes the open sub-items of an item with the reason it closes the item with. Delivering this after #6 would void its work on `shut`."},
  {number: 8, author_association: "OWNER", labels: [{name: "approved"}],
   title: "Make `poll` cap its wait at 480s",
   body: "`test_poll` in `.agent/tests/scripts` fails because `poll` lets its wait grow to 960s."},
  {number: 9, author_association: "OWNER", labels: [{name: "approved"}],
   title: "Make `check` reject roadmap backends that are not executable",
   body: "`test_check` in `.agent/tests/scripts` fails because `check` accepts a roadmap backend that is not executable."},
  {number: 10, author_association: "OWNER", labels: [{name: "approved"}],
   title: "Make `change-under-review` leave out ignored files",
   body: "`test_change_under_review` in `.agent/tests/scripts` fails because `change-under-review` shows files git ignores. Due \($due)."},
  {number: 11, author_association: "NONE", labels: [{name: "approved"}],
   title: "Make `verdict` print its usage when given arguments",
   body: "`verdict` ignores its arguments instead of printing `usage: verdict <response` to stderr and exiting 2."}
] | map({state: "open", comments: []} + .)' >.git/issues.json
cp .git/issues.json "$tmp/seeded.json"
: >"$tmp/closed"
mkdir "$tmp/bin"
cat >"$tmp/bin/gh" <<EOF
#!/usr/bin/env bash
s=$repo/.git/issues.json
exec 9>"$tmp/lock"
flock 9
[[ \$* != *' -'[fF]' '* ]] || rm -f "$tmp/listed"
if [[ \$* =~ /issues/([6-9]|1[01])\ .*state=closed ]]; then
  echo "\$(wc -l <"$tmp/events.jsonl") \${BASH_REMATCH[1]}" >>"$tmp/closed"
fi
if [[ \$* == *'issues?state=open'* ]]; then
  jq '[.[] | select(.state == "open") | .number] as \$o
    | map(if .number > 10 and (.parent | IN(\$o[]) | not) then .author_association = "NONE" else . end)' "\$s" >"\$s.new" && mv "\$s.new" "\$s"
  if [[ \$(ps -ww -o args= -p "\$PPID") == *' candidates' ]]; then
    if [ ! -e "$tmp/parent" ]; then
      p=\$(jq -r --rawfile e "$tmp/events.jsonl" --slurpfile d "$tmp/seeded.json" '
        [\$e | splits("\n") | fromjson? | select(.type == "assistant" and .parent_tool_use_id == null)
          | .message.content[]? | select(.type == "tool_use")
          | select(.name == "Skill" and .input.skill == "deliver" or .name == "Agent" and .input.subagent_type == "impl")
          | .input | .. | strings] as \$t
        | [.[] | select(.state == "open") | .number] as \$o
        | first(\$d[0][5:10][] | select(.number | IN(\$o[])) | select(.body as \$b | any(\$t[]; contains(\$b))) | .number) // empty' "\$s")
      [ -z "\$p" ] || {
        jq --argjson p "\$p" 'map(if .number == 11 then . + {parent: \$p, author_association: "OWNER"} else . end)' "\$s" >"\$s.new" && mv "\$s.new" "\$s"
        echo "\$p" >"$tmp/parent"
      }
    fi
    if jq -e 'all(.[5:10][]; .state == "closed")' "\$s" >/dev/null; then
      [ ! -e "$tmp/listed" ] || { touch "$tmp/stop"; flock -u 9; sleep 300; }
      touch "$tmp/listed"
    fi
  fi
fi
exec "$here/stub/gh" "\$@"
EOF
chmod +x "$tmp/bin/gh"
PATH=$tmp/bin:$PATH hours=4 usd=200 scenario /lead Skill --include-hook-events

jq -nR --rawfile c "$tmp/closed" --slurpfile s "$tmp/seeded.json" '
  [inputs | fromjson? // {}] as $e
  | [$s[0][5:][] | [.number, .body]] as $d
  | [range($e | length) as $i | $e[$i]
      | select(.type == "assistant" and .parent_tool_use_id == null and any(.message.content[]?; .type == "tool_use"))
      | [$i, .message.id]] as $u
  | [($c | splits("\n") | select(. != "") | split(" ") | map(tonumber) as [$l, $n]
      | ([$u[] | select(.[0] < $l)] | last[1]) as $m
      | [(first($u[] | select(.[1] == $m) | .[0]) // $l) - 0.5, "end", $n]),
     (range($e | length) as $i | $e[$i]
      | if .type == "assistant" and .parent_tool_use_id == null then
          .message.content[]? | select(.type == "tool_use") | . as $t
          | if .name == "Skill" and .input.skill == "deliver" or .name == "Agent" and .input.subagent_type == "impl" then
              (first($d[] | select(.[1] as $b | any($t.input | .. | strings; contains($b))) | .[0]) // null) as $n
              | if $n == null and .name == "Agent" then empty else [$i, "start", $n] end
            elif .name == "Bash" then
              .input.command // "" | if test("scripts/poll ") then [$i, "poll"] elif test("\\bcandidates\\b") then [$i, "list"] else empty end
            else empty end
        elif .subtype == "hook_response" and .hook_event == "Stop" and .exit_code == 0 then [$i, "await"]
        else empty end)]
  | sort_by(.[0])
  | reduce .[] as [$i, $k, $n] ({run: [], log: []};
      .run = if $k == "start" then .run + [$n] elif $k == "end" then .run - [$n] else .run end
      | .log += [{k: $k, n: $n, run: .run}])
  | .log' "$tmp/events.jsonl" >"$tmp/timeline.json" || :

delivered 6 7 8 9 10
check relisted test -e "$tmp/stop"
check picked jq -e '[.[] | select(.k == "start") | .n] | all(. != null) and unique == [6, 7, 8, 9, 10]' "$tmp/timeline.json"
check prioritized jq -e '[.[] | select(.k == "start") | .n] | .[0] == 10 and index(7) < index(6)' "$tmp/timeline.json"
check capped jq -e '[.[].run | unique | length] | max == 3' "$tmp/timeline.json"
check overlap jq -e 'all(.[]; .run | contains([6, 7]) | not)' "$tmp/timeline.json"
check descendant jq -e --slurpfile p "$tmp/parent" 'all(.[]; .run | contains([$p[0], 11]) | not)' "$tmp/timeline.json"
check listed jq -e 'any(.[]; .k == "list" and .run != [])' "$tmp/timeline.json"
check polled jq -e 'any(.[]; .k == "poll") and all(.[]; .k != "poll" or .run == [])' "$tmp/timeline.json"
check awaited jq -e 'any(.[]; .k == "await" and .run != [])' "$tmp/timeline.json"
check unblocked jq -e '.[5].title | contains("blocked") | not' .git/issues.json
check untouched jq -e --slurpfile s "$tmp/seeded.json" '.[:5] == $s[0][:5]' .git/issues.json
exit "$fail"
