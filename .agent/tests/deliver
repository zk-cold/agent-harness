#!/usr/bin/env bash
set -euo pipefail
[ "${DELIVER_SCENARIO-}" = 1 ] || exit 0
. "$(dirname "$0")/lib/scenario"
jq -n '[{number: 1, state: "open", author_association: "OWNER", comments: [], labels: [{name: "approved"}],
  title: "Make `roadmap-gh close` close items as not planned",
  body: "`.agent/tests/scripts` fails because `close` closes items as completed."}]' >.git/issues.json
scenario "/deliver $(.agent/scripts/roadmap gh . show 1)"

approved() {
  jq -rs --arg c "$1" '
    [.[] | .message.content[]? | select(.type == "tool_use" and .input.subagent_type == $c) | .id] as $ids
    | [.[] | .message.content[]? | select(.type == "tool_result" and (.tool_use_id | IN($ids[])))] | last.content
    | if type == "string" then . else map(.text? // empty) | join("\n") end' "$tmp/events.jsonl" |
    grep -Eqx '[[:space:]]*Verdict: APPROVE[[:space:]]*'
}

check result jq -e 'select(.type == "result") | .subtype == "success"' "$tmp/events.jsonl"
for c in earn-its-place-critic alignment-critic full-review-critic; do
  check "$c" approved "$c"
done
delivered 1
exit "$fail"
