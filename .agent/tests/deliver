#!/usr/bin/env bash
set -euo pipefail
[ "${DELIVER_SCENARIO-}" = 1 ] || exit 0
. "$(dirname "$0")/lib/scenario"
jq -n '[{number: 1, state: "open", author_association: "OWNER", comments: [], labels: [{name: "approved"}],
  title: "Make `roadmap-gh close` close items as not planned",
  body: "`.agent/tests/scripts` fails because `close` closes items as completed."}]' >.git/issues.json
scenario "/deliver $(.agent/scripts/roadmap gh . show 1)"

critics=(earn-its-place-critic alignment-critic full-review-critic)
verdicts() {
  jq -rs '
    . as $e | length as $end
    | ([range($end) as $i | $e[$i] | select(.subtype == "task_notification" and .tool_use_id)
        | {key: .tool_use_id, value: [$i, .handback_report.text // .summary]}] | from_entries) as $n
    | ([range($end) as $i | $e[$i].message.content[]? | select(.type == "tool_result")
        | {key: .tool_use_id, value: [$i, .content]}] | from_entries) as $r
    | range($end) as $i | $e[$i].message.content[]?
    | select(.type == "tool_use" and (.input.subagent_type // "" | endswith("-critic")))
    | (if .input.run_in_background then $n[.id] else $n[.id] // $r[.id] end // [$end, ""]) as [$f, $t]
    | [.input.subagent_type, ($t | if type == "array" then map(.text? // empty) | join("\n") else . // "" end
        | [splits("\n") | capture("^\\s*Verdict: (?<v>APPROVE|REJECT)\\s*$").v] | first // "FAIL"), $i, $f] | @tsv' "$tmp/events.jsonl"
}
approved() { verdicts | awk -v c="$1" '$1 == c {v = $2} END {exit v != "APPROVE"}'; }
ordered() {
  verdicts | awk -v cs="${critics[*]}" '
    BEGIN {k = split(cs, c); n = 1; f = -1}
    $1 != c[n] || $3 < f {exit 1}
    {f = $4}
    $2 == "REJECT" {n = 1}
    $2 == "APPROVE" {n = n % k + 1}'
}

check result jq -e 'select(.type == "result") | .subtype == "success"' "$tmp/events.jsonl"
for c in "${critics[@]}"; do
  check "$c" approved "$c"
done
check ordered ordered
delivered 1
exit "$fail"
