export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
here=$(cd "$(dirname "$0")" && pwd)
root=$here/../..
tmp=$(mktemp -d)
repo=$tmp/repo
echo "$tmp"
mkdir "$repo"
git -C "$root" ls-files -z -co --exclude-standard | (cd "$root" && tar --null -T - -c) | tar -x -C "$repo"
sed -i 's/shut "$1" not_planned$/shut "$1" completed/' "$repo/.agent/scripts/roadmap-gh"
[ "$("$repo/.agent/tests/scripts" 2>&1 | grep '^test_')" = test_close ]
git -C "$repo" init -q -b main
git -C "$repo" add -A
git -C "$repo" commit -qm seed
git -C "$repo" tag seed
export PATH=$here/stub:$PATH
cd "$repo"

scenario() {
  env -u DELIVER_SCENARIO -u LEAD_SCENARIO timeout -k 1m 2h claude -p "$1" \
    --max-budget-usd 40 --setting-sources project --add-dir "$tmp" \
    --permission-mode dontAsk --allowedTools Agent Bash Edit Glob Grep Read Write "${@:2}" \
    --output-format stream-json --verbose >"$tmp/events.jsonl" &
  local pid=$!
  trap "kill $pid 2>/dev/null || :" EXIT
  until [ -e "$tmp/stop" ] || ! kill -0 "$pid" 2>/dev/null; do sleep 10; done
  kill "$pid" 2>/dev/null || :
  wait "$pid" || :
}

fail=0
check() { "${@:2}" >/dev/null 2>&1 || { echo "$1"; fail=1; }; }
delivered() {
  check completed jq -e --argjson n "$1" '.[$n - 1] | .state == "closed" and .state_reason == "completed"' .git/issues.json
  check clean test -z "$(git status --porcelain)"
  check on-root test "$(git branch --show-current)" = main
  check branches test "$(git branch --format='%(refname:short)')" = main
  check worktrees test "$(git worktree list | wc -l)" = 1
  check tests-untouched git diff --quiet seed main -- .agent/tests
  check fixed .agent/tests/scripts
}
